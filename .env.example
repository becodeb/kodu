# ─────────────────────────────────────────────────────────────
# Base de datos (Prisma 7 + driver adapter pg)
# ─────────────────────────────────────────────────────────────
# Local (sin Docker): apunta a tu Postgres.
# Con docker compose: el host es el nombre del servicio "db".
DATABASE_URL="postgresql://kodu:kodu@localhost:5432/koduedu?schema=public"
POSTGRES_USER="kodu"
POSTGRES_PASSWORD="kodu"
POSTGRES_DB="koduedu"
# Puerto del host para el Postgres de docker-compose.yml (cambialo si el 5432 esta ocupado).
POSTGRES_PORT="5432"

# ─────────────────────────────────────────────────────────────
# Sesiones (JWT firmado, guardado en cookie httpOnly)
# ─────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="cambiame-por-un-secreto-largo-de-al-menos-32-caracteres"
SESSION_TTL_HOURS="168"

# ─────────────────────────────────────────────────────────────
# Lista blanca de dominios institucionales (separados por coma)
# ─────────────────────────────────────────────────────────────
# Vacio = cualquier dominio puede registrarse. Con valores, solo esos.
ALLOWED_EMAIL_DOMAINS=""


# Emails que reciben rol ADMIN automaticamente al registrarse.
ADMIN_EMAILS="admin@rededucativa.edu.ar"


# ─────────────────────────────────────────────────────────────
# Motores de IA. Los tres hablan el dialecto OpenAI.
# OJO: las BASE_URL van SIN /v1 (el codigo concatena /v1/chat/completions).
# ─────────────────────────────────────────────────────────────
# Alpha: gratuito, multimodal, sin cupo. Es el default.
# Alpha esta FUERA DE SERVICIO (dejo de ser gratuito). El motor principal es
# MiniMax M3; DeepSeek solo entra como respaldo automatico.

AI_ALPHA_BASE_URL="https://openrouter.ai/api"
AI_ALPHA_MODEL="stealth/ox-alpha"
AI_ALPHA_MAX_TOKENS="65536"
AI_ALPHA_USER_TOKEN_LIMIT="0"
# Largo maximo de UN mensaje del docente, en caracteres. No raciona: es para
# que el pedido entre en la ventana de contexto junto con el HTML y el historial.
AI_ALPHA_MAX_INPUT_CHARS="400000"


# DeepSeek: se paga por token, por eso lleva tope por docente (0 = sin tope).
AI_DEEPSEEK_API_KEY=""
AI_DEEPSEEK_BASE_URL="https://api.deepseek.com"
AI_DEEPSEEK_MODEL="deepseek-v4-flash"
AI_DEEPSEEK_MAX_TOKENS="8192"
AI_DEEPSEEK_USER_TOKEN_LIMIT="300000"
AI_DEEPSEEK_MAX_INPUT_CHARS="24000"


# MiniMax M3 en GMI Cloud: gratuito, multimodal y con contexto de 1M.
AI_MINIMAX_API_KEY=""
AI_MINIMAX_BASE_URL="https://api.gmi-serving.com"
AI_MINIMAX_MODEL="MiniMaxAI/MiniMax-M3"
AI_MINIMAX_USER_TOKEN_LIMIT="0"
AI_MINIMAX_MAX_INPUT_CHARS="400000"


# Si los modelos multimodales reciben las imagenes adjuntas.
AI_VISION="true"

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
PUBLIC_SITE_URL="http://localhost:3000"
UPLOADS_DIR="./uploads"
# Tamano maximo por archivo adjunto (imagenes y PDFs), en MB.
MAX_UPLOAD_MB="10"
PORT="3000"
# Puerto del host para la app en docker-compose.yml (cambialo si el 3000 esta ocupado).
APP_PORT="3000"
HOST="0.0.0.0"

# Seed inicial (npm run db:seed)
SEED_ADMIN_EMAIL="admin@rededucativa.edu.ar"
SEED_ADMIN_PASSWORD="Kodu.Admin.2026"
SEED_ADMIN_NAME="Administración KoduEdu"

# ─────────────────────────────────────────────────────────────
# Google Sign-In (Google Cloud > Credenciales > ID de cliente OAuth)
# Vacias = no se muestra el boton. El redirect_uri registrado en Google debe
# ser exactamente <PUBLIC_SITE_URL>/auth/callback
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
