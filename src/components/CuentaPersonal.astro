---
import { prisma } from '../lib/db.ts';
import { hasResendApiKey } from '../lib/env.ts';
import { emailConfiable } from '../lib/orgs/membresia.ts';
import { organizacionParaEmail } from '../lib/orgs/resolucion.ts';
import { mensajeAccesoIa, type ResultadoAccesoIa } from '../lib/orgs/acceso.ts';
import ReenviarVerificacion from './ReenviarVerificacion.tsx';
import ElegirSede from './ElegirSede.tsx';

interface Props {
  /**
   * odd/tasks/planes-y-cobros.md (T2/T3): cuando el llamador ya resolvió
   * `resolverAccesoIa`, se lo pasa acá para mostrar el motivo puntual (sin
   * créditos, licencia institucional no activa) en vez del cartel genérico
   * de "cuenta personal". `undefined` conserva el comportamiento de siempre
   * (páginas que todavía no migraron a `resolverAccesoIa`).
   */
  acceso?: ResultadoAccesoIa;
}

const { acceso } = Astro.props;
const razonConcreta =
  acceso && acceso.reason !== 'no_credits' && !acceso.reason.startsWith('license_') && acceso.reason !== 'org_archived'
    ? null
    : acceso;

/**
 * odd/tasks/organizaciones.md (T2, decisión del dueño — "Cuenta personal"):
 * quien entra con un email que no coincide con ninguna organización tiene
 * una cuenta personal que por ahora no puede usar la app. Gatea `/app`,
 * `/app/project/[id]` y `/app/rules` A NIVEL DE PÁGINA — nunca toca
 * `Workspace.tsx` ni `ChatPanel.tsx` (otra sesión los está cambiando en
 * paralelo, feat/generacion-simple-y-reanudable).
 *
 * T3: variante para quien está acá SÓLO porque todavía no confirmó el email
 * (Resend configurado) — con la key cargada, `unirSiCorresponde` nunca la une
 * mientras `emailVerifiedAt` sea `null` (`emailConfiable`, membresia.ts), así
 * que este cartel es lo único que ve hasta que confirme. Sin key, TODA cuenta
 * nace verificada (NO_PROVIDER) y esta condición nunca se cumple — la cuenta
 * personal de siempre (dominio/lista blanca ajenos) sigue viendo el cartel
 * genérico de abajo.
 *
 * T4: tercera variante — el picker de sede. Sólo aparece cuando el email es
 * CONFIABLE (si hiciera falta confirmar el email primero, gana la variante de
 * arriba) y resuelve a una NETWORK (`requiereElegirSede`, misma fuente que
 * `unirSiCorresponde` — nunca se decide acá con otro criterio).
 */
const userId = Astro.locals.user?.id;
const fila = userId
  ? await prisma.user.findUnique({ where: { id: userId }, select: { email: true, emailVerifiedAt: true } })
  : null;
const sinVerificar = hasResendApiKey() && fila !== null && fila.emailVerifiedAt === null;

const resolucion =
  fila && !sinVerificar && emailConfiable(fila) ? await organizacionParaEmail(fila.email) : null;
// Sin sedes activas para ofrecer, el picker quedaría vacío: mejor el cartel
// genérico de "cuenta personal" que una lista sin nada para tocar.
const requiereElegirSede =
  resolucion !== null && 'red' in resolucion && resolucion.sedes.length > 0 ? resolucion : null;
---

<div class="kodu-card mx-auto mt-8 max-w-lg p-8 text-center sm:mt-16">
  {
    sinVerificar ? (
      <>
        <h1 class="font-display text-xl font-bold text-ink-900">Confirmá tu email</h1>
        <p class="mx-auto mt-3 max-w-md text-sm text-ink-600">
          Te mandamos un enlace de confirmación a tu correo. Entrá a tu bandeja (y a spam, por las
          dudas) y tocalo para empezar a usar la IA.
        </p>
        <p class="mx-auto mt-3 max-w-md text-sm text-ink-500">
          Si tu colegio te mandó un enlace de invitación, podés usarlo igual sin confirmar el email
          primero.
        </p>
        <div class="mt-5">
          <ReenviarVerificacion client:load />
        </div>
      </>
    ) : requiereElegirSede ? (
      <>
        <h1 class="font-display text-xl font-bold text-ink-900">Elegí tu sede</h1>
        <p class="mx-auto mt-3 max-w-md text-sm text-ink-600">
          Tu email es de una red de colegios. Elegí a cuál de sus sedes pertenecés para empezar a usar
          la IA.
        </p>
        <ElegirSede
          client:load
          redName={requiereElegirSede.red.name}
          sedes={requiereElegirSede.sedes}
        />
      </>
    ) : razonConcreta && razonConcreta.reason === 'no_credits' ? (
      <>
        <h1 class="font-display text-xl font-bold text-ink-900">Te quedaste sin créditos</h1>
        <p class="mx-auto mt-3 max-w-md text-sm text-ink-600">{mensajeAccesoIa(razonConcreta)}</p>
        <a href="/app/plan" class="kodu-btn kodu-btn-primary mt-5 inline-flex">Ver mi plan</a>
      </>
    ) : razonConcreta && razonConcreta.reason === 'license_pending_payment' ? (
      <>
        {/* T11: nunca "tu prueba terminó" — esta institución nunca tuvo prueba. */}
        <h1 class="font-display text-xl font-bold text-ink-900">Contratá para empezar a usar Kodu</h1>
        <p class="mx-auto mt-3 max-w-md text-sm text-ink-600">{mensajeAccesoIa(razonConcreta)}</p>
        {razonConcreta.esAdminOrg && (
          <a href="/org/plan" class="kodu-btn kodu-btn-primary mt-5 inline-flex">Contratar</a>
        )}
      </>
    ) : razonConcreta ? (
      <>
        <h1 class="font-display text-xl font-bold text-ink-900">
          {razonConcreta.esAdminOrg ? 'Tu licencia no está activa' : 'La licencia de tu institución no está activa'}
        </h1>
        <p class="mx-auto mt-3 max-w-md text-sm text-ink-600">{mensajeAccesoIa(razonConcreta)}</p>
        {razonConcreta.esAdminOrg && (
          <a href="/org/plan" class="kodu-btn kodu-btn-primary mt-5 inline-flex">Contratar</a>
        )}
      </>
    ) : (
      <>
        <h1 class="font-display text-xl font-bold text-ink-900">Tu cuenta es personal</h1>
        <p class="mx-auto mt-3 max-w-md text-sm text-ink-600">
          Todavía no usás la IA de Kodu desde ninguna institución. Un colegio te suma cuando te manda
          un enlace de invitación, o cuando agrega tu email a su lista — apenas eso pase, vas a poder
          seguir usando la IA.
        </p>
        <p class="mx-auto mt-3 max-w-md text-sm text-ink-500">
          Tus recursos ya creados no se borraron: te vuelven a quedar disponibles en cuanto te sumes a
          una organización.
        </p>
      </>
    )
  }
</div>
