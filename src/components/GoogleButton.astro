---
/**
 * Botón de ingreso con Google.
 *
 * Va arriba del formulario porque es la forma principal de entrar: no hay que
 * inventar ni recordar una contraseña más. El de correo queda abajo, disponible
 * para quien lo prefiera.
 */
interface Props {
  /** "Continuar" sirve para entrar y para registrarse: Google resuelve las dos. */
  texto?: string;
}

const { texto = 'Continuar con Google' } = Astro.props;
---

<a
  href="/auth/google"
  class="flex w-full items-center justify-center gap-3 rounded-lg border border-linea bg-superficie px-4 py-2.5 text-sm font-semibold text-ink-900 transition-colors hover:border-ink-500"
>
  <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" class="shrink-0">
    <path
      fill="#4285F4"
      d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62z"
    ></path>
    <path
      fill="#34A853"
      d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z"
    ></path>
    <path
      fill="#FBBC05"
      d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33z"
    ></path>
    <path
      fill="#EA4335"
      d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z"
    ></path>
  </svg>
  {texto}
</a>
