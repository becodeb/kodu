---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Oculta el header. */
  bare?: boolean;
  /** Layout ancho, para el editor de recursos. */
  wide?: boolean;
  /** Sin contenedor: cada sección maneja su propio ancho (home). */
  bleed?: boolean;
  /** Header sobre el pizarrón: la home arranca en oscuro desde arriba. */
  darkHeader?: boolean;
}

const {
  title = 'KoduEdu',
  description = 'Plataforma educativa de creación de recursos didácticos asistida por IA.',
  bare = false,
  wide = false,
  bleed = false,
  darkHeader = false,
} = Astro.props;

const user = Astro.locals.user;
const pageTitle = title === 'KoduEdu' ? title : `${title} · KoduEdu`;

// El header cambia de piel según el fondo sobre el que se apoya: en la home
// arranca dentro del pizarrón, así el panel llega hasta el borde de arriba.
const headerClass = darkHeader ? 'bg-pizarron-900 text-tiza-50' : 'border-b border-slate-200 bg-white';
const navLink = darkHeader ? 'text-tiza-200 hover:text-white' : 'text-ink-700 hover:text-brand-600';
const navCta = darkHeader ? 'kodu-btn-tiza py-1.5' : 'kodu-btn-primary py-1.5';
const navGhost = darkHeader ? 'kodu-btn-pizarron py-1.5' : 'kodu-btn-ghost py-1.5';
const brandName = darkHeader ? 'text-tiza-50' : 'text-ink-900';
const userName = darkHeader ? 'hidden text-tiza-400 sm:inline' : 'hidden text-ink-500 sm:inline';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Piazzolla:opsz,wght@8..30,600;8..30,700;8..30,800&display=swap"
    />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen">
    {
      !bare && (
        <header class={headerClass}>
          <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
            <a href="/" class={`flex items-center gap-2 font-bold ${brandName}`}>
              <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand-600 text-sm text-white">
                K
              </span>
              KoduEdu
            </a>

            <div class="flex items-center gap-3 text-sm">
              <a href="/gallery" class={navLink}>
                Galería
              </a>

              {user ? (
                <>
                  <a href="/app" class={navLink}>
                    Mis recursos
                  </a>
                  <a href="/app/rules" class={navLink}>
                    Reglas
                  </a>
                  <span class={userName}>{user.name}</span>
                  <form method="POST" action="/api/auth/logout">
                    <button type="submit" class={navGhost}>
                      Salir
                    </button>
                  </form>
                </>
              ) : (
                <>
                  <a href="/login" class={navLink}>
                    Ingresar
                  </a>
                  <a href="/register" class={navCta}>
                    Crear cuenta
                  </a>
                </>
              )}
            </div>
          </nav>
        </header>
      )
    }

    <main class={bleed ? '' : `mx-auto px-4 py-8 ${wide ? 'max-w-[110rem]' : 'max-w-6xl'}`}>
      <slot />
    </main>
  </body>
</html>
