---
import '../styles/global.css';
import { getEnv } from '../lib/env.ts';

interface Props {
  title?: string;
  description?: string;
  /** Oculta el header. */
  bare?: boolean;
  /** Layout ancho, para el editor de recursos. */
  wide?: boolean;
  /** Sin contenedor: cada sección maneja su propio ancho (home). */
  bleed?: boolean;
}

const {
  title = 'KoduEdu',
  description = 'Plataforma educativa de creación de recursos didácticos asistida por IA.',
  bare = false,
  wide = false,
  bleed = false,
} = Astro.props;

const user = Astro.locals.user;
const pageTitle = title === 'Kodu' ? title : `${title} · Kodu`;

// Los scrapers de WhatsApp y compañía necesitan la URL absoluta, y tiene que
// salir de PUBLIC_SITE_URL: detrás del proxy, Astro.url cree que el sitio es
// http:// y una imagen http en una página https no la levanta ningún scraper.
const ogImage = new URL('/brand/og.png', getEnv().PUBLIC_SITE_URL).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/brand/kodu-icono.png" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Archivo+Black&display=swap"
    />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen">
    {
      !bare && (
        <header class="border-b border-linea bg-white">
          <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
            <a href="/" class="flex items-center" aria-label="Kodu, ir al inicio">
              <img
                src="/brand/kodu-logo.webp"
                alt="Kodu"
                width="420"
                height="158"
                class="h-8 w-auto"
              />
            </a>

            <div class="flex items-center gap-3 text-sm">
              <a href="/gallery" class="text-ink-700 hover:text-brand-600">
                Galería
              </a>

              {user ? (
                <>
                  <a href="/app" class="text-ink-700 hover:text-brand-600">
                    Mis recursos
                  </a>
                  <a href="/app/rules" class="text-ink-700 hover:text-brand-600">
                    Reglas
                  </a>
                  <span class="hidden text-ink-500 sm:inline">{user.name}</span>
                  <form method="POST" action="/api/auth/logout">
                    <button type="submit" class="kodu-btn-ghost py-1.5">
                      Salir
                    </button>
                  </form>
                </>
              ) : (
                <>
                  <a href="/login" class="text-ink-700 hover:text-brand-600">
                    Ingresar
                  </a>
                  <a href="/register" class="kodu-btn-primary py-1.5">
                    Crear cuenta
                  </a>
                </>
              )}
            </div>
          </nav>
        </header>
      )
    }

    <main class={bleed ? '' : `mx-auto px-4 py-8 ${wide ? 'max-w-[110rem]' : 'max-w-6xl'}`}>
      <slot />
    </main>
  </body>
</html>
