---
import '../styles/global.css';
import { getEnv } from '../lib/env.ts';
import { prisma } from '../lib/db.ts';
import { ensureGrants, balance } from '../lib/billing/creditos-servicio.ts';

interface Props {
  title?: string;
  description?: string;
  /** Oculta el header. */
  bare?: boolean;
  /** Layout ancho, para el editor de recursos. */
  wide?: boolean;
  /** Sin contenedor: cada sección maneja su propio ancho (home). */
  bleed?: boolean;
  /**
   * T5 (odd/tasks/responsive-celulares.md): achica el padding vertical del
   * `<main>` sólo por debajo de `lg` — el editor de recursos necesita cada
   * píxel para que el composer no quede bajo el pliegue a 390×664. Arriba de
   * `lg` sigue siendo exactamente `py-8`, así que ninguna otra página (que no
   * pasa esta prop) ni el desktop del editor cambian.
   */
  compactMobile?: boolean;
}

const {
  title = 'KoduEdu',
  description = 'Plataforma educativa de creación de recursos didácticos asistida por IA.',
  bare = false,
  wide = false,
  bleed = false,
  compactMobile = false,
} = Astro.props;

const user = Astro.locals.user;
// Para marcar el enlace de la seccion en la que esta parado el docente.
const ruta = Astro.url.pathname;
// El Taller de ideas vive bajo /app pero es otro destino del menú.
const enElTaller = ruta === '/app/taller' || ruta.startsWith('/app/taller/');

/**
 * odd/tasks/organizaciones.md (T8): "Mi organización" — sólo para un DOCENTE
 * que administra alguna (campus o red); el superadmin ya tiene "Panel" y no
 * es su herramienta principal (igual puede entrar a `/org` escribiendo la
 * URL — la página autoriza sola con `alcance.ts`, este link es sólo el
 * atajo).
 *
 * Opción MÁS BARATA que sigue siendo correcta: en vez de llamar a
 * `alcanceDeAdmin` (2-3 queries, remembering archivado/membresía vigente —
 * ver alcance.ts) en CADA página del sitio para un docente logueado, alcanza
 * con una existencia de fila `OrganizationAdmin` (`findFirst`, un solo índice
 * por `userId`). La única diferencia observable: un docente que dejó de ser
 * elegible (se fue de la sede/red que administraba, fila "colgada" — ver el
 * comentario de `alcance.ts`) puede ver el link un instante de más hasta que
 * alguien borre esa fila vieja; al entrar, `/org` hace el chequeo COMPLETO y
 * lo manda de vuelta a `/app` si ya no le sirve. Nunca al revés: no puede
 * FALTAR el link para alguien que sigue siendo un admin vigente.
 */
const esPotencialAdminDeOrganizacion =
  user && user.role !== 'ADMIN'
    ? (await prisma.organizationAdmin.findFirst({ where: { userId: user.id }, select: { userId: true } })) !== null
    : false;
const pageTitle = title === 'Kodu' ? title : `${title} · Kodu`;

/**
 * odd/tasks/planes-y-cobros.md (T2): saldo de créditos en el encabezado,
 * sólo para una cuenta PERSONAL (sin organización) que no sea el superadmin
 * (el superadmin siempre tiene acceso, sin créditos de por medio — tabla de
 * verdad de `resolverAccesoIa`). `ensureGrants` es idempotente: llamarlo acá
 * de nuevo (puede que ya haya corrido en esta misma request, por ejemplo
 * dentro de `resolverAccesoIa` en `/app`) no duplica nada.
 */
const saldoCreditos =
  user && user.role !== 'ADMIN' && user.organizationId === null
    ? await (async () => {
        await ensureGrants(user.id, new Date());
        return balance(user.id);
      })()
    : null;

// Los scrapers de WhatsApp y compañía necesitan la URL absoluta, y tiene que
// salir de PUBLIC_SITE_URL: detrás del proxy, Astro.url cree que el sitio es
// http:// y una imagen http en una página https no la levanta ningún scraper.
const ogImage = new URL('/brand/og.png', getEnv().PUBLIC_SITE_URL).href;

// La canónica sale de PUBLIC_SITE_URL por el mismo motivo que la og:image, y
// además sin querystring: `?next=/admin` en /login son la misma página para un
// buscador, y si cada variante se declara distinta Google elige una al azar.
// La barra final se normaliza (salvo en la raíz) para no publicar dos URLs de
// la misma página.
const rutaCanonica = ruta !== '/' && ruta.endsWith('/') ? ruta.slice(0, -1) : ruta;
const canonical = new URL(rutaCanonica, getEnv().PUBLIC_SITE_URL).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/brand/kodu-icono.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Archivo+Black&display=swap"
    />
    <title>{pageTitle}</title>
    <script is:inline>
      // Va inline y en el <head> a proposito: si el tema se aplicara despues de
      // pintar, el docente veria un fogonazo blanco en cada navegacion.
      (function () {
        try {
          var saved = localStorage.getItem('kodu-tema');
          var dark = saved ? saved === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.setAttribute('data-theme', 'dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen">
    {
      !bare && (
        <header class="border-b border-linea bg-superficie">
          {/* Tres columnas de igual ancho: asi los enlaces del medio quedan
              centrados respecto de la pagina y no respecto del hueco que dejan
              el logo y los botones, que es lo que los corria a la derecha. */}
          <nav class="mx-auto grid max-w-6xl grid-cols-[1fr_auto_1fr] items-center gap-2 px-4 py-3 sm:gap-4">
            <a
              href="/"
              class="flex min-w-[85px] shrink-0 items-center justify-self-start"
              aria-label="Kodu, ir al inicio"
            >
              <img
                src="/brand/kodu-logo.webp"
                alt="Kodu"
                width="420"
                height="158"
                class="h-8 w-auto shrink-0"
              />
            </a>

            {/* odd/tasks/planes-y-cobros.md (T6): "Precios" sumó un cuarto
                enlace al centro y, con "Mis recursos"/"Taller" puestos
                (docente logueado), a 390px ya no entraban todos en una
                línea — `min-w-0` (sin esto, un item de grid no se achica
                nunca por debajo de su contenido) + `overflow-x-auto` acá
                contienen el scroll DENTRO de esta franja en vez de ensanchar
                la página entera, que es lo que de verdad importa (no debe
                haber scroll horizontal del documento). */}
            <div class="flex min-w-0 items-center gap-2.5 overflow-x-auto text-sm whitespace-nowrap sm:gap-6">
              <a
                href="/gallery"
                class="kodu-nav-link"
                aria-current={ruta.startsWith('/gallery') ? 'page' : undefined}
              >
                Galería
              </a>
              {/* odd/tasks/planes-y-cobros.md (T6): precios públicos, visible
                  para todos — con o sin sesión, docente u organización. */}
              <a
                href="/precios"
                class="kodu-nav-link"
                aria-current={ruta.startsWith('/precios') ? 'page' : undefined}
              >
                Precios
              </a>
              {user && (
                /* odd/tasks/taller-de-ideas.md: un destino más, no un ajuste. En
                   el celular se achica a "Taller" para que la barra entre. */
                <a
                  href="/app/taller"
                  class="kodu-nav-link"
                  aria-current={enElTaller ? 'page' : undefined}
                >
                  <span class="hidden sm:inline">Taller de ideas</span>
                  <span class="sm:hidden">Taller</span>
                </a>
              )}
              {user && (
                <a
                  href="/app"
                  class="kodu-nav-link"
                  aria-current={ruta.startsWith('/app') && !enElTaller ? 'page' : undefined}
                >
                  {/* Con el Taller, la barra no entra en un celular con
                      "Mis recursos" entero (se partía en dos líneas). */}
                  <span class="hidden sm:inline">Mis recursos</span>
                  <span class="sm:hidden">Recursos</span>
                </a>
              )}
            </div>

            <div class="flex items-center gap-2 justify-self-end text-sm">
              {saldoCreditos !== null && (
                <a
                  href="/app/plan"
                  class="flex items-center gap-1.5 rounded-lg border border-linea bg-sutil px-2 py-1.5 text-sm text-ink-700 hover:border-ink-500 sm:px-2.5"
                >
                  <span class="h-1.5 w-1.5 rounded-full bg-brand-600" aria-hidden="true" />
                  <span class="hidden sm:inline">Te quedan {saldoCreditos} créditos</span>
                  <span class="sm:hidden">{saldoCreditos} créditos</span>
                </a>
              )}
              {esPotencialAdminDeOrganizacion && (
                <a
                  href="/org"
                  aria-current={ruta.startsWith('/org') ? 'page' : undefined}
                  class={`flex items-center gap-1.5 rounded-lg border bg-sutil px-2 py-1.5 text-sm sm:px-2.5 ${
                    ruta.startsWith('/org')
                      ? 'border-brand-300 text-brand-700'
                      : 'border-linea text-ink-700 hover:border-ink-500'
                  }`}
                >
                  <span class="h-1.5 w-1.5 rounded-full bg-brand-600" aria-hidden="true" />
                  <span class="hidden sm:inline">Mi organización</span>
                  <span class="sm:hidden">Org</span>
                </a>
              )}
              {user?.role === 'ADMIN' && (
                /* Distinto por tipo, no por volumen: un objeto con borde y un
                   punto, contra los enlaces de texto pelado del centro — así
                   se lee de un vistazo que este es otro tipo de destino. */
                <a
                  href="/admin"
                  aria-current={ruta.startsWith('/admin') ? 'page' : undefined}
                  class={`flex items-center gap-1.5 rounded-lg border bg-sutil px-2 py-1.5 text-sm sm:px-2.5 ${
                    ruta.startsWith('/admin')
                      ? 'border-brand-300 text-brand-700'
                      : 'border-linea text-ink-700 hover:border-ink-500'
                  }`}
                >
                  <span class="h-1.5 w-1.5 rounded-full bg-brand-600" aria-hidden="true" />
                  {/* En el celular, sólo el punto: con el Taller en la barra, el
                      texto no entra junto con el resto. */}
                  <span class="hidden sm:inline">Panel</span>
                  <span class="sr-only sm:hidden">Panel de administración</span>
                </a>
              )}
              {user ? (
                /* Reglas y el tema viven acá adentro: son ajustes, no destinos.
                   La barra se queda solo con los dos lugares a los que uno va. */
                <details class="relative" data-menu>
                  <summary
                    class="flex cursor-pointer list-none items-center gap-2 rounded-lg border border-linea px-2.5 py-1.5 text-ink-700 hover:border-ink-500"
                  >
                    <span
                      class="grid h-6 w-6 place-items-center rounded-full bg-brand-600 text-xs font-semibold text-white"
                      aria-hidden="true"
                    >
                      {user.name.trim().charAt(0).toUpperCase()}
                    </span>
                    <span class="hidden sm:inline">{user.name}</span>
                  </summary>

                  <div
                    class="kodu-card absolute right-0 z-50 mt-2 w-60 overflow-hidden p-1 shadow-lg"
                  >
                    <a
                      href="/app/rules"
                      class="block rounded-md px-3 py-2 text-ink-700 hover:bg-sutil"
                    >
                      Reglas de la IA
                    </a>

                    <button
                      type="button"
                      data-toggle-tema
                      class="flex w-full items-center justify-between rounded-md px-3 py-2 text-left text-ink-700 hover:bg-sutil"
                    >
                      Modo oscuro
                      <span
                        aria-hidden="true"
                        class="flex h-5 w-9 shrink-0 items-center rounded-full bg-linea p-0.5 transition-colors"
                        data-riel
                      >
                        <span
                          class="h-4 w-4 rounded-full bg-superficie shadow-sm transition-transform"
                          data-perilla
                        />
                      </span>
                    </button>

                    <div class="my-1 h-px bg-linea" />

                    <form method="POST" action="/api/auth/logout">
                      <button
                        type="submit"
                        class="w-full rounded-md px-3 py-2 text-left text-ink-700 hover:bg-sutil"
                      >
                        Salir
                      </button>
                    </form>
                  </div>
                </details>
              ) : (
                <>
                  <a href="/login" class="text-ink-700 hover:text-brand-600">
                    Ingresar
                  </a>
                  <a href="/register" class="kodu-btn-primary py-1.5">
                    Crear cuenta
                  </a>
                </>
              )}
            </div>
          </nav>
        </header>
      )
    }

    <main
      class={bleed
        ? ''
        : `mx-auto px-4 ${compactMobile ? 'py-3 lg:py-8' : 'py-8'} ${wide ? 'max-w-[110rem]' : 'max-w-6xl'}`}
    >
      <slot />
    </main>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        // [data-menu] es genérico a propósito: además del perfil, M5 lo
        // reusa para el menú de acciones de cada fila de la tabla de
        // docentes, y este mismo script tiene que cerrar cualquiera de ellos.
        var menus = document.querySelectorAll('[data-menu]');
        var boton = document.querySelector('[data-toggle-tema]');
        if (!boton) return;

        var riel = boton.querySelector('[data-riel]');
        var perilla = boton.querySelector('[data-perilla]');

        function pintar() {
          var oscuro = root.getAttribute('data-theme') === 'dark';
          riel.classList.toggle('bg-brand-600', oscuro);
          riel.classList.toggle('bg-linea', !oscuro);
          perilla.style.transform = oscuro ? 'translateX(1rem)' : 'translateX(0)';
          boton.setAttribute('aria-pressed', String(oscuro));
        }

        boton.addEventListener('click', function () {
          var oscuro = root.getAttribute('data-theme') === 'dark';
          if (oscuro) root.removeAttribute('data-theme');
          else root.setAttribute('data-theme', 'dark');
          try { localStorage.setItem('kodu-tema', oscuro ? 'light' : 'dark'); } catch (e) {}
          pintar();
        });

        // El <details> no se cierra solo al hacer clic afuera.
        document.addEventListener('click', function (event) {
          menus.forEach(function (menu) {
            if (menu.open && !menu.contains(event.target)) menu.open = false;
          });
        });
        document.addEventListener('keydown', function (event) {
          if (event.key !== 'Escape') return;
          menus.forEach(function (menu) {
            menu.open = false;
          });
        });

        pintar();
      })();
    </script>
  </body>
</html>
