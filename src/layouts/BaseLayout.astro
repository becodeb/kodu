---
import '../styles/global.css';
import { getEnv } from '../lib/env.ts';
import { prisma } from '../lib/db.ts';
import { ensureGrants, balance } from '../lib/billing/creditos-servicio.ts';
import { resolverAccesoIa } from '../lib/orgs/acceso.ts';
import NewProjectButton from '../components/NewProjectButton.tsx';

interface Props {
  title?: string;
  description?: string;
  /** Oculta el header. */
  bare?: boolean;
  /** Layout ancho, para el editor de recursos. */
  wide?: boolean;
  /** Sin contenedor: cada sección maneja su propio ancho (home). */
  bleed?: boolean;
  /**
   * T5 (odd/tasks/responsive-celulares.md): achica el padding vertical del
   * `<main>` sólo por debajo de `lg` — el editor de recursos necesita cada
   * píxel para que el composer no quede bajo el pliegue a 390×664. Arriba de
   * `lg` sigue siendo exactamente `py-8`, así que ninguna otra página (que no
   * pasa esta prop) ni el desktop del editor cambian.
   */
  compactMobile?: boolean;
  /**
   * Sin "Ingresar"/"Crear cuenta" en la barra para quien no tiene sesión: la
   * página ya trae sus propios botones y los de la barra no la retoman al
   * volver (ej. la invitación, que necesita `?next=` para sumar a la sede).
   */
  sinAccesoEnBarra?: boolean;
}

const {
  title = 'KoduEdu',
  description = 'Plataforma educativa de creación de recursos didácticos asistida por IA.',
  bare = false,
  wide = false,
  bleed = false,
  compactMobile = false,
  sinAccesoEnBarra = false,
} = Astro.props;

const user = Astro.locals.user;
// Para marcar el enlace de la seccion en la que esta parado el docente.
const ruta = Astro.url.pathname;
// "Mis recursos" marca su sección y el editor, pero no el plan, las reglas ni
// el Taller de ideas: viven bajo /app pero son otros destinos.
const enMisRecursos =
  ruta.startsWith('/app') && !['/app/plan', '/app/rules', '/app/taller'].some((otra) => ruta.startsWith(otra));

/**
 * odd/tasks/organizaciones.md (T8): "Mi organización" — sólo para un DOCENTE
 * que administra alguna (campus o red); el superadmin ya tiene "Panel" y no
 * es su herramienta principal (igual puede entrar a `/org` escribiendo la
 * URL — la página autoriza sola con `alcance.ts`, este link es sólo el
 * atajo).
 *
 * Opción MÁS BARATA que sigue siendo correcta: en vez de llamar a
 * `alcanceDeAdmin` (2-3 queries, remembering archivado/membresía vigente —
 * ver alcance.ts) en CADA página del sitio para un docente logueado, alcanza
 * con una existencia de fila `OrganizationAdmin` (`findFirst`, un solo índice
 * por `userId`). La única diferencia observable: un docente que dejó de ser
 * elegible (se fue de la sede/red que administraba, fila "colgada" — ver el
 * comentario de `alcance.ts`) puede ver el link un instante de más hasta que
 * alguien borre esa fila vieja; al entrar, `/org` hace el chequeo COMPLETO y
 * lo manda de vuelta a `/app` si ya no le sirve. Nunca al revés: no puede
 * FALTAR el link para alguien que sigue siendo un admin vigente.
 */
const esPotencialAdminDeOrganizacion =
  user && user.role !== 'ADMIN'
    ? (await prisma.organizationAdmin.findFirst({ where: { userId: user.id }, select: { userId: true } })) !== null
    : false;
const pageTitle = title === 'Kodu' ? title : `${title} · Kodu`;

/**
 * odd/tasks/planes-y-cobros.md (T2): saldo de créditos en el encabezado,
 * sólo para una cuenta PERSONAL (sin organización) que no sea el superadmin
 * (el superadmin siempre tiene acceso, sin créditos de por medio — tabla de
 * verdad de `resolverAccesoIa`). `ensureGrants` es idempotente: llamarlo acá
 * de nuevo (puede que ya haya corrido en esta misma request, por ejemplo
 * dentro de `resolverAccesoIa` en `/app`) no duplica nada.
 */
const saldoCreditos =
  user && user.role !== 'ADMIN' && user.organizationId === null
    ? await (async () => {
        await ensureGrants(user.id, new Date());
        return balance(user.id);
      })()
    : null;

/**
 * "Crear recurso" es la acción principal de la barra, así que sólo aparece si
 * de verdad se puede crear: una cuenta personal sin créditos o una institución
 * en sólo-lectura no lo ven (en /app se les explica por qué). Misma regla que
 * `POST /api/projects`, para que el botón nunca prometa algo que el servidor
 * después rechaza.
 */
const accesoIa = user ? await resolverAccesoIa(user) : null;
const puedeCrear = accesoIa?.allowed ?? false;

/**
 * Un docente cuya institución le cubre el uso (licencia vigente) no tiene
 * créditos propios: en vez del saldo, la barra le muestra que está en el plan
 * de su institución, sin límite. Sólo con la licencia habilitando la IA (las
 * razones `license_*` con `allowed`): una licencia vencida no promete nada.
 */
const planInstitucional =
  user && user.organizationId && accesoIa?.allowed && accesoIa.reason.startsWith('license_')
    ? await prisma.organization.findUnique({
        where: { id: user.organizationId },
        select: { name: true, parent: { select: { name: true } } },
      })
    : null;
// El plan es de la raíz (la red, si la sede cuelga de una): ese es el nombre
// que figura en lo que se contrató.
const nombrePlanInstitucional = planInstitucional ? (planInstitucional.parent?.name ?? planInstitucional.name) : null;
// Quien administra la institución va a ver el plan contratado; un docente
// miembro, a "Mi plan", que le explica que lo paga la institución.
const enlacePlanInstitucional = esPotencialAdminDeOrganizacion ? '/org/plan' : '/app/plan';

// Los scrapers de WhatsApp y compañía necesitan la URL absoluta, y tiene que
// salir de PUBLIC_SITE_URL: detrás del proxy, Astro.url cree que el sitio es
// http:// y una imagen http en una página https no la levanta ningún scraper.
const ogImage = new URL('/brand/og.png', getEnv().PUBLIC_SITE_URL).href;

// La canónica sale de PUBLIC_SITE_URL por el mismo motivo que la og:image, y
// además sin querystring: `?next=/admin` en /login son la misma página para un
// buscador, y si cada variante se declara distinta Google elige una al azar.
// La barra final se normaliza (salvo en la raíz) para no publicar dos URLs de
// la misma página.
const rutaCanonica = ruta !== '/' && ruta.endsWith('/') ? ruta.slice(0, -1) : ruta;
const canonical = new URL(rutaCanonica, getEnv().PUBLIC_SITE_URL).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/brand/kodu-icono.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Archivo+Black&display=swap"
    />
    <title>{pageTitle}</title>
    <script is:inline>
      // Va inline y en el <head> a proposito: si el tema se aplicara despues de
      // pintar, el docente veria un fogonazo blanco en cada navegacion.
      (function () {
        try {
          var saved = localStorage.getItem('kodu-tema');
          var dark = saved ? saved === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.setAttribute('data-theme', 'dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen">
    {
      !bare && (
        <header class="kodu-elev sticky top-0 z-40 border-b border-linea bg-superficie">
          {/* Tres botones de destino agrupados en una cápsula, y a la derecha
              una sola acción principal ("Crear recurso"). Todo lo que es
              ajuste o cuenta (organización, reglas, tema, salir) vive en el
              menú del avatar: la barra se queda con los lugares a los que uno
              va y con lo único que uno viene a hacer. */}
          <nav
            aria-label="Navegación principal"
            class="mx-auto flex max-w-6xl items-center gap-2 px-4 py-2 sm:gap-4 sm:py-2.5 lg:gap-6"
          >
            {/* Con sesión, el logo lleva al Taller de ideas: la portada pública
                (/) es la de alguien sin cuenta y, vista ya adentro, parecía
                que te había cerrado la sesión. */}
            <a
              href={user ? '/app/taller' : '/'}
              class="flex shrink-0 items-center"
              aria-label={user ? 'Kodu, ir al Taller de ideas' : 'Kodu, ir al inicio'}
            >
              <img
                src="/brand/kodu-logo.webp"
                alt="Kodu"
                width="420"
                height="158"
                class="h-8 w-auto max-sm:hidden"
              />
              {/* En el celular, sólo el ícono: el logo entero no deja lugar a
                  los tres destinos y al botón de crear. */}
              <img src="/brand/kodu-icono.png" alt="Kodu" width="32" height="32" class="h-8 w-8 sm:hidden" />
            </a>

            {/* odd/tasks/planes-y-cobros.md (T6): a 360px los destinos pueden no
                entrar en una línea — `min-w-0` + `overflow-x-auto` contienen el
                scroll DENTRO de la cápsula en vez de ensanchar la página. */}
            <div class="kodu-nav-grupo min-w-0 overflow-x-auto [scrollbar-width:none]">
              <a
                href="/gallery"
                class="kodu-nav-link"
                aria-current={ruta.startsWith('/gallery') ? 'page' : undefined}
              >
                Galería
              </a>
              {user && (
                <a
                  href="/app"
                  class="kodu-nav-link"
                  aria-current={enMisRecursos ? 'page' : undefined}
                >
                  <span class="max-sm:hidden">Mis recursos</span>
                  <span class="sm:hidden">Recursos</span>
                </a>
              )}
              {/* odd/tasks/planes-y-cobros.md (T6): precios públicos, visible
                  para todos — con o sin sesión, docente u organización. */}
              <a
                href="/precios"
                class={`kodu-nav-link ${user ? "max-sm:hidden" : ""}`}
                aria-current={ruta.startsWith('/precios') ? 'page' : undefined}
              >
                Precios
              </a>
            </div>

            <div class="ml-auto flex shrink-0 items-center gap-2 sm:gap-3">
              {saldoCreditos !== null && (
                <a
                  href="/app/plan"
                  aria-current={ruta.startsWith('/app/plan') ? 'page' : undefined}
                  class="flex items-center gap-2 rounded-lg border border-linea px-3 py-2 text-sm font-semibold whitespace-nowrap text-ink-700 transition-colors hover:border-ink-500 hover:text-ink-900 max-md:hidden"
                >
                  <span class="h-2 w-2 rounded-full bg-brand-600" aria-hidden="true" />
                  {saldoCreditos} créditos
                </a>
              )}
              {nombrePlanInstitucional && (
                <a
                  href={enlacePlanInstitucional}
                  title={`Tu institución cubre el uso de Kodu: no tenés límite de créditos.`}
                  aria-label={`Plan ${nombrePlanInstitucional}: sin límite de créditos`}
                  aria-current={ruta.startsWith(enlacePlanInstitucional) ? 'page' : undefined}
                  class="flex max-w-[15rem] items-center gap-2 rounded-lg border border-linea px-3 py-2 text-sm font-semibold whitespace-nowrap text-ink-700 transition-colors hover:border-ink-500 hover:text-ink-900 max-md:hidden"
                >
                  {/* Infinito: la marca de "sin límite", en el lugar donde
                      una cuenta personal ve su saldo. */}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-brand-600">
                    <path d="M12 12c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4Zm0 0c2 2.67 4 4 6 4a4 4 0 0 0 0-8c-2 0-4 1.33-6 4Z" />
                  </svg>
                  <span class="truncate">Plan {nombrePlanInstitucional}</span>
                </a>
              )}
              {user?.role === 'ADMIN' && (
                /* Sólo para el superadmin: otro tipo de destino, con borde y
                   punto, distinto de los botones de la cápsula. */
                <a
                  href="/admin"
                  aria-current={ruta.startsWith('/admin') ? 'page' : undefined}
                  class={`flex items-center gap-1.5 rounded-lg border px-2.5 py-2 text-sm font-semibold ${
                    ruta.startsWith('/admin')
                      ? 'border-brand-300 text-brand-700'
                      : 'border-linea text-ink-700 hover:border-ink-500'
                  }`}
                >
                  <span class="h-2 w-2 rounded-full bg-brand-600" aria-hidden="true" />
                  <span class="max-sm:hidden">Panel</span>
                  <span class="sr-only sm:hidden">Panel de administración</span>
                </a>
              )}
              {puedeCrear && <NewProjectButton client:load />}
              {user ? (
                <details class="relative" data-menu>
                  <summary
                    class="flex cursor-pointer list-none items-center gap-1.5 rounded-full border border-linea p-1 text-ink-700 sm:pr-2 transition-colors hover:border-ink-500"
                    aria-label={`Menú de cuenta: ${user.name}`}
                  >
                    <span
                      class="grid h-8 w-8 place-items-center rounded-full bg-brand-600 text-sm font-bold text-white"
                      aria-hidden="true"
                    >
                      {user.name.trim().charAt(0).toUpperCase()}
                    </span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="max-sm:hidden">
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </summary>

                  <div class="kodu-card absolute right-0 z-50 mt-2 w-64 overflow-hidden p-1 text-sm shadow-lg">
                    <div class="px-3 py-2">
                      <p class="truncate font-semibold text-ink-900">{user.name}</p>
                      <p class="truncate text-xs text-ink-500">{user.email}</p>
                    </div>

                    <div class="my-1 h-px bg-linea" />

                    {saldoCreditos !== null && (
                      /* En pantallas chicas el saldo no entra en la barra. */
                      <a href="/app/plan" class="block rounded-md px-3 py-2 text-ink-700 hover:bg-sutil md:hidden">
                        Te quedan {saldoCreditos} créditos
                      </a>
                    )}
                    {nombrePlanInstitucional && (
                      <a href={enlacePlanInstitucional} class="block rounded-md px-3 py-2 text-ink-700 hover:bg-sutil md:hidden">
                        Plan {nombrePlanInstitucional} · sin límite de créditos
                      </a>
                    )}
                    {/* En el celular "Precios" no entra en la cápsula de la barra. */}
                    <a href="/precios" class="block rounded-md px-3 py-2 text-ink-700 hover:bg-sutil sm:hidden">
                      Precios
                    </a>
                    {esPotencialAdminDeOrganizacion && (
                      <a href="/org" class="block rounded-md px-3 py-2 text-ink-700 hover:bg-sutil">
                        Mi organización
                      </a>
                    )}
                    <a href="/app/rules" class="block rounded-md px-3 py-2 text-ink-700 hover:bg-sutil">
                      Reglas de la IA
                    </a>

                    <button
                      type="button"
                      data-toggle-tema
                      class="flex w-full items-center justify-between rounded-md px-3 py-2 text-left text-ink-700 hover:bg-sutil"
                    >
                      Modo oscuro
                      <span
                        aria-hidden="true"
                        class="flex h-5 w-9 shrink-0 items-center rounded-full bg-linea p-0.5 transition-colors"
                        data-riel
                      >
                        <span
                          class="h-4 w-4 rounded-full bg-superficie shadow-sm transition-transform"
                          data-perilla
                        />
                      </span>
                    </button>

                    <div class="my-1 h-px bg-linea" />

                    <form method="POST" action="/api/auth/logout">
                      <button
                        type="submit"
                        class="w-full rounded-md px-3 py-2 text-left text-ink-700 hover:bg-sutil"
                      >
                        Salir
                      </button>
                    </form>
                  </div>
                </details>
              ) : sinAccesoEnBarra ? null : (
                <>
                  <a href="/login" class="px-1 text-sm font-semibold whitespace-nowrap text-ink-700 hover:text-brand-600">
                    Ingresar
                  </a>
                  <a href="/register" class="kodu-btn-primary py-2 whitespace-nowrap">
                    Crear cuenta
                  </a>
                </>
              )}
            </div>
          </nav>
        </header>
      )
    }

    <main
      class={bleed
        ? ''
        : `mx-auto px-4 ${compactMobile ? 'py-3 lg:py-8' : 'py-8'} ${wide ? 'max-w-[110rem]' : 'max-w-6xl'}`}
    >
      <slot />
    </main>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        // [data-menu] es genérico a propósito: además del perfil, M5 lo
        // reusa para el menú de acciones de cada fila de la tabla de
        // docentes, y este mismo script tiene que cerrar cualquiera de ellos.
        var menus = document.querySelectorAll('[data-menu]');
        var boton = document.querySelector('[data-toggle-tema]');
        if (!boton) return;

        var riel = boton.querySelector('[data-riel]');
        var perilla = boton.querySelector('[data-perilla]');

        function pintar() {
          var oscuro = root.getAttribute('data-theme') === 'dark';
          riel.classList.toggle('bg-brand-600', oscuro);
          riel.classList.toggle('bg-linea', !oscuro);
          perilla.style.transform = oscuro ? 'translateX(1rem)' : 'translateX(0)';
          boton.setAttribute('aria-pressed', String(oscuro));
        }

        boton.addEventListener('click', function () {
          var oscuro = root.getAttribute('data-theme') === 'dark';
          if (oscuro) root.removeAttribute('data-theme');
          else root.setAttribute('data-theme', 'dark');
          try { localStorage.setItem('kodu-tema', oscuro ? 'light' : 'dark'); } catch (e) {}
          pintar();
        });

        // El <details> no se cierra solo al hacer clic afuera.
        document.addEventListener('click', function (event) {
          menus.forEach(function (menu) {
            if (menu.open && !menu.contains(event.target)) menu.open = false;
          });
        });
        document.addEventListener('keydown', function (event) {
          if (event.key !== 'Escape') return;
          menus.forEach(function (menu) {
            menu.open = false;
          });
        });

        pintar();
      })();
    </script>
  </body>
</html>
