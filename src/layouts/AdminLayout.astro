---
import BaseLayout from './BaseLayout.astro';
import EncabezadoAdmin from '../components/admin/EncabezadoAdmin.astro';
import NavAdmin from '../components/admin/NavAdmin.astro';
import { hasResendApiKey, billingNow } from '../lib/env.ts';
import { colaDeRevision } from '../lib/billing/revision.ts';
import { resumenMonotributo } from '../lib/billing/monotributo.ts';
import { enviarRecordatoriosDeRenovacion } from '../lib/billing/recordatorios.ts';

/**
 * Cascarón de /admin (odd/tasks/admin-ui-redesign.md, T01): barra lateral
 * agrupada en escritorio (≥1024px), cajón en celular, encabezado por página
 * (ver `EncabezadoAdmin.astro`).
 *
 * Reemplaza la fila horizontal de 13 pestañas sueltas (sin agrupar, sin
 * landing page — `/admin` sólo redirigía) por 4 grupos que responden "¿qué
 * está haciendo el admin ahora?": Personas (quién entra), Contenido (qué se
 * generó), IA (cómo se genera), Plata (cuánto cuesta). Mismos hrefs que
 * antes — ningún link se mueve, así que nada que ya apunte a `/admin/uso`
 * (por ejemplo) se rompe.
 */

interface Props {
  title?: string;
  description?: string;
  breadcrumb?: { etiqueta: string; href?: string }[];
}

const { title = 'Panel', description, breadcrumb } = Astro.props;
const ruta = Astro.url.pathname;

/**
 * odd/tasks/organizaciones.md (T3, decisión del dueño — "fallback sin
 * Resend"): en TODAS las páginas de /admin, no sólo Docentes, porque el
 * fallback afecta a cualquier alta nueva sin importar qué pestaña se esté
 * mirando. `hasResendApiKey()` lee `env.ts`, que además loguea el mismo
 * aviso una vez al arrancar el servidor (para quien no entra a /admin).
 */
const resendApagado = !hasResendApiKey();

// odd/tasks/planes-y-cobros.md (T5): entrada de la cola de revisión en TODA
// página de /admin (mismo criterio que el aviso de Resend arriba) — altas
// propias sin confirmar + contactos "Hablemos" sin contactar. Sólo cuenta +
// lista con link; la pantalla para confirmar dominios/matrícula es T7.
const cola = await colaDeRevision();

// odd/tasks/planes-y-cobros.md (T4b): disparo perezoso de los avisos de
// renovación (30/7 días) en TODA página de /admin — mismo criterio que la
// cola de revisión y el aviso de Resend de arriba; idempotente por el único
// de `RenewalReminder`, así que entrar varias veces por día no manda mails
// de más. También hay un endpoint interno para un cron (ver ese archivo).
await enviarRecordatoriosDeRenovacion(billingNow());

// odd/tasks/planes-y-cobros.md (T7): aviso del tope del monotributo, en TODA
// página de /admin por encima del 90% (el dueño lo pidió "en el superadmin",
// no sólo en /admin/facturacion) — dismissible por sesión del navegador
// (localStorage, ver el script al final de este layout).
const monotributo = await resumenMonotributo(billingNow());
const monotributoCritico = monotributo.porcentaje !== null && monotributo.porcentaje >= 0.9;

const RESUMEN = { href: '/admin', etiqueta: 'Resumen', titulo: 'El estado general de la plataforma, de un vistazo', icono: 'resumen' };

const GRUPOS = [
  {
    nombre: 'Personas',
    items: [
      { href: '/admin/usuarios', etiqueta: 'Docentes', titulo: 'Buscar y administrar cuentas de docentes', icono: 'persona' },
      {
        href: '/admin/organizaciones',
        etiqueta: 'Organizaciones',
        titulo: 'Redes y sedes que administran su propia gente',
        icono: 'organizacion',
      },
      {
        href: '/admin/altas',
        etiqueta: cola.length > 0 ? `Altas (${cola.length})` : 'Altas',
        titulo: 'Instituciones y contactos esperando revisión',
        icono: 'altaPersona',
      },
    ],
  },
  {
    nombre: 'Contenido',
    items: [
      { href: '/admin/proyectos', etiqueta: 'Recursos', titulo: 'Todo lo que se generó en la plataforma', icono: 'grilla' },
      { href: '/admin/demo', etiqueta: 'Demo', titulo: 'La cuenta pública de prueba', icono: 'play' },
    ],
  },
  {
    nombre: 'IA',
    items: [
      { href: '/admin/motores', etiqueta: 'Motores', titulo: 'Catálogo de modelos de IA habilitados', icono: 'cpu' },
      { href: '/admin/proveedores', etiqueta: 'Proveedores', titulo: 'Cuentas de API que alimentan los motores', icono: 'enchufe' },
      { href: '/admin/generacion', etiqueta: 'Generación', titulo: 'Cómo se reparten los turnos entre motores', icono: 'chispas' },
      { href: '/admin/trazas', etiqueta: 'Trazas', titulo: 'El registro turno por turno', icono: 'lista' },
    ],
  },
  {
    nombre: 'Plata',
    items: [
      { href: '/admin/uso', etiqueta: 'Uso', titulo: 'Consumo agregado de la plataforma', icono: 'barras' },
      { href: '/admin/metricas', etiqueta: 'Métricas', titulo: 'Costo por organización y por mes', icono: 'tendencia' },
      { href: '/admin/precios', etiqueta: 'Precios', titulo: 'Tarifas de planes y bandas', icono: 'etiqueta' },
      { href: '/admin/facturacion', etiqueta: 'Facturación', titulo: 'Pagos, facturas y el tope del monotributo', icono: 'recibo' },
    ],
  },
];
---

<BaseLayout title={title} wide>
  <div class="lg:flex lg:items-start lg:gap-8">
    {/* Barra superior de celular: sólo el botón que abre el cajón — el
        encabezado de la página (EncabezadoAdmin) ya dice en qué pantalla
        está, así que no hace falta repetir "Panel" acá. */}
    <div class="mb-4 lg:hidden">
      <button
        type="button"
        id="abrir-cajon-admin"
        aria-expanded="false"
        aria-controls="cajon-admin"
        class="kodu-btn-ghost gap-2 py-1.5"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        Secciones
      </button>
    </div>

    {/* Barra lateral de escritorio: fija al hacer scroll, nunca se superpone
        porque el contenido vive en una columna flex hermana con min-w-0. */}
    <aside class="hidden lg:block lg:w-56 lg:shrink-0">
      <div class="sticky top-8">
        <NavAdmin ruta={ruta} resumen={RESUMEN} grupos={GRUPOS} variante="escritorio" />
      </div>
    </aside>

    {/* Cajón de celular: oculto por defecto (`hidden`, lo saca el script de
        abajo), por encima de todo. El fondo semitransparente cierra al
        tocarlo, igual que el `<details data-menu>` del header de
        BaseLayout. */}
    <div id="cajon-admin" class="fixed inset-0 z-50 hidden lg:hidden">
      <div class="absolute inset-0 bg-carbon/40" data-cerrar-cajon aria-hidden="true" />
      <div class="kodu-card absolute inset-y-0 left-0 w-72 overflow-y-auto p-4 shadow-lg">
        <div class="mb-4 flex items-center justify-between">
          <span class="font-display text-sm font-bold text-ink-900">Panel</span>
          <button type="button" data-cerrar-cajon aria-label="Cerrar menú" class="text-ink-500 hover:text-ink-900">
            ✕
          </button>
        </div>
        <NavAdmin ruta={ruta} resumen={RESUMEN} grupos={GRUPOS} variante="movil" />
      </div>
    </div>

    <div class="min-w-0 flex-1">
      <EncabezadoAdmin title={title} description={description} breadcrumb={breadcrumb} />

      {
        resendApagado && (
          <div class="mb-6 max-w-2xl rounded-lg border border-brand-300 bg-brand-50 px-4 py-3 text-sm text-brand-700">
            La verificación de email está apagada: falta <code class="font-mono">RESEND_API_KEY</code>. Toda
            cuenta nueva se toma como verificada.
          </div>
        )
      }

      {
        monotributoCritico && (
          <div
            id="aviso-monotributo"
            class="mb-6 max-w-2xl rounded-lg border border-amber-400 bg-amber-50 px-4 py-3 text-sm text-amber-800"
            data-porcentaje={Math.round(monotributo.porcentaje! * 100)}
          >
            <div class="flex items-start justify-between gap-3">
              <p>
                Te estás acercando al tope del monotributo: facturaste el {Math.round(monotributo.porcentaje! * 100)}%
                de los últimos 12 meses. Mirá el detalle en <a href="/admin/facturacion" class="underline">Facturación</a>.
              </p>
              <button type="button" id="cerrar-aviso-monotributo" class="shrink-0 text-amber-700 hover:text-amber-900" aria-label="Cerrar">
                ✕
              </button>
            </div>
          </div>
        )
      }

      {
        cola.length > 0 && (
          <div class="mb-6 max-w-2xl rounded-lg border border-linea bg-sutil px-4 py-3 text-sm">
            <p class="font-medium text-ink-900">
              {cola.length} {cola.length === 1 ? 'institución espera' : 'instituciones esperan'} revisión
            </p>
            <ul class="mt-2 space-y-1">
              {cola.slice(0, 5).map((item) => (
                <li class="text-ink-700">
                  {item.tipo === 'ALTA' ? (
                    <a href={`/admin/organizaciones/${item.organizationId}`} class="text-brand-600 hover:underline">
                      {item.nombre}
                    </a>
                  ) : (
                    <span>{item.nombre} (Hablemos)</span>
                  )}
                  {item.declaredStudents !== null && <span class="text-ink-500"> · {item.declaredStudents} alumnos</span>}
                </li>
              ))}
            </ul>
            {cola.length > 5 && <p class="mt-2 text-xs text-ink-500">y {cola.length - 5} más.</p>}
          </div>
        )
      }

      <slot />
    </div>
  </div>
</BaseLayout>

<script>
  // Cajón de celular: abrir/cerrar + Escape + click afuera. Mismo criterio
  // que el `<details data-menu>` de BaseLayout, pero esto es un overlay
  // fijo (no un <details>) porque tiene que cubrir toda la pantalla y
  // bloquear el scroll del fondo mientras está abierto.
  const boton = document.getElementById('abrir-cajon-admin');
  const cajon = document.getElementById('cajon-admin');
  if (boton && cajon) {
    const cerrar = () => {
      cajon.classList.add('hidden');
      boton.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('overflow-hidden');
    };
    const abrir = () => {
      cajon.classList.remove('hidden');
      boton.setAttribute('aria-expanded', 'true');
      document.body.classList.add('overflow-hidden');
    };
    boton.addEventListener('click', abrir);
    cajon.querySelectorAll('[data-cerrar-cajon]').forEach((el) => el.addEventListener('click', cerrar));
    document.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape' && !cajon.classList.contains('hidden')) cerrar();
    });
  }
</script>

<script>
  // T7: el aviso del monotributo se puede cerrar por el resto de la sesión
  // del navegador — `localStorage`, per-viewer, nunca estado compartido (el
  // dueño lo vuelve a ver en la próxima sesión, o si el porcentaje cambió).
  const CLAVE = 'kodu-aviso-monotributo-cerrado-para';
  const aviso = document.getElementById('aviso-monotributo');
  if (aviso) {
    const porcentaje = aviso.dataset.porcentaje ?? '';
    try {
      if (localStorage.getItem(CLAVE) === porcentaje) aviso.remove();
    } catch {
      // localStorage puede fallar (ventana privada, storage bloqueado) — el
      // aviso simplemente no se puede cerrar en ese caso, nunca rompe la
      // página.
    }
    document.getElementById('cerrar-aviso-monotributo')?.addEventListener('click', () => {
      try {
        localStorage.setItem(CLAVE, porcentaje);
      } catch {
        // ídem arriba.
      }
      aviso.remove();
    });
  }
</script>

