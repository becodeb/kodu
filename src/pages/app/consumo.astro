---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { usageByUser } from '../../lib/ai/usage.ts';
import { getEnv } from '../../lib/env.ts';

/**
 * Consumo de tokens por docente (SPEC: agregado en agosto de 2026).
 *
 * Es una pantalla para nosotros, no para los docentes: sirve para ver quién
 * gasta cuánto en el proveedor pago antes de que llegue la factura. Por eso es
 * sólo para ADMIN.
 *
 * **Vista histórica desde M2**: `usageByUser()` agrupa por el enum viejo
 * (`TokenUsage.provider`), que las filas escritas DESPUÉS de M2 ya no
 * completan (ver `src/lib/ai/usage.ts` — ahora escriben `aiModelId`). Esta
 * pantalla entera la reemplaza `/admin/usuarios` en M5; hasta entonces sigue
 * mostrando fielmente el consumo histórico y nada del consumo nuevo, en vez
 * de mentir agrupándolo bajo un motor equivocado.
 */
const user = Astro.locals.user!;

if (user.role !== 'ADMIN') {
  return Astro.redirect('/app', 302);
}

const env = getEnv();
const filas = await usageByUser();

const topes: Record<string, number> = {
  ALPHA: env.AI_ALPHA_USER_TOKEN_LIMIT,
  DEEPSEEK: env.AI_DEEPSEEK_USER_TOKEN_LIMIT,
  MINIMAX: env.AI_MINIMAX_USER_TOKEN_LIMIT,
};

/** Nombres históricos del enum viejo, sólo para esta vista de archivo. */
const NOMBRES_HISTORICOS: Record<string, string> = {
  ALPHA: 'Alpha',
  DEEPSEEK: 'DeepSeek',
  MINIMAX: 'MiniMax M3',
};

const nombreProveedor = (valor: string | null) =>
  (valor && NOMBRES_HISTORICOS[valor]) ?? valor ?? 'Motor nuevo (ver /admin/motores)';

const miles = (n: number) => n.toLocaleString('es-AR');

const totalPorProveedor = filas.reduce<Record<string, number>>((acumulado, fila) => {
  const clave = fila.provider ?? '—';
  acumulado[clave] = (acumulado[clave] ?? 0) + fila.total;
  return acumulado;
}, {});
---

<BaseLayout title="Consumo de tokens">
  <header class="mb-6 max-w-2xl">
    <h1 class="text-2xl font-bold text-ink-900">Consumo de tokens</h1>
    <p class="mt-1 text-sm text-ink-500">
      Cuánto usó cada docente en cada motor. MiniMax es gratuito; DeepSeek se paga por token y
      sólo se usa como respaldo, así que lo que aparezca ahí es lo que costó.
    </p>
  </header>

  <div class="mb-6 grid gap-3 sm:grid-cols-3">
    {
      Object.entries(NOMBRES_HISTORICOS).map(([valor, nombre]) => (
        <div class="kodu-card p-4">
          <p class="text-xs font-medium tracking-wide text-ink-500 uppercase">{nombre}</p>
          <p class="font-display mt-1 text-2xl text-ink-900">{miles(totalPorProveedor[valor] ?? 0)}</p>
          <p class="mt-1 text-xs text-ink-500">
            {topes[valor]
              ? `Tope por docente: ${miles(topes[valor]!)} tokens`
              : 'Sin tope por docente'}
          </p>
        </div>
      ))
    }
  </div>

  {
    filas.length === 0 ? (
      <div class="kodu-card p-10 text-center">
        <h2 class="text-lg font-semibold text-ink-900">Todavía no hay consumo registrado</h2>
        <p class="mx-auto mt-2 max-w-md text-sm text-ink-500">
          Se empieza a contar desde el primer mensaje que se mande después de esta actualización.
        </p>
      </div>
    ) : (
      <div class="kodu-card overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-linea text-xs text-ink-500 uppercase">
            <tr>
              <th class="px-4 py-3 font-medium">Docente</th>
              <th class="px-4 py-3 font-medium">Motor</th>
              <th class="px-4 py-3 text-right font-medium">Pedido</th>
              <th class="px-4 py-3 text-right font-medium">Respuesta</th>
              <th class="px-4 py-3 text-right font-medium">Total</th>
              <th class="px-4 py-3 text-right font-medium">Turnos</th>
            </tr>
          </thead>
          <tbody>
            {filas.map((fila) => {
              const tope = (fila.provider && topes[fila.provider]) ?? 0;
              const pasado = tope > 0 && fila.total >= tope;

              return (
                <tr class="border-b border-linea last:border-0">
                  <td class="px-4 py-3">
                    <span class="block font-medium text-ink-900">{fila.name}</span>
                    <span class="block text-xs text-ink-500">{fila.email}</span>
                  </td>
                  <td class="px-4 py-3 text-ink-700">{nombreProveedor(fila.provider)}</td>
                  <td class="px-4 py-3 text-right tabular-nums text-ink-500">
                    {miles(fila.promptTokens)}
                  </td>
                  <td class="px-4 py-3 text-right tabular-nums text-ink-500">
                    {miles(fila.completionTokens)}
                  </td>
                  <td
                    class={`px-4 py-3 text-right font-semibold tabular-nums ${
                      pasado ? 'text-red-600' : 'text-ink-900'
                    }`}
                  >
                    {miles(fila.total)}
                    {pasado && <span class="block text-xs font-normal">tope alcanzado</span>}
                  </td>
                  <td class="px-4 py-3 text-right tabular-nums text-ink-500">{fila.turnos}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )
  }
  <section class="mt-8">
    <h2 class="text-lg font-semibold text-ink-900">Motores</h2>
    <p class="mt-1 max-w-2xl text-sm text-ink-500">
      El motor de trabajo es <strong class="font-semibold text-ink-700">MiniMax M3</strong>, y es el
      único que puede elegir un docente. <strong class="font-semibold text-ink-700">DeepSeek</strong>
      está bajo llave: no aparece en la interfaz y entra solo, como respaldo, cuando MiniMax no
      responde después de diez intentos. Alpha salió de servicio al dejar de ser gratuito; su
      consumo histórico se sigue mostrando arriba.
    </p>
  </section>
</BaseLayout>
