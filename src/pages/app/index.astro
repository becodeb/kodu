---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewProjectButton from '../../components/NewProjectButton.tsx';
import ProjectCardActions from '../../components/ProjectCardActions.tsx';
import CuentaPersonal from '../../components/CuentaPersonal.astro';
import AvisoRenovacion from '../../components/billing/AvisoRenovacion.astro';
import { prisma } from '../../lib/db.ts';
import { haceTiempo } from '../../lib/format/fecha.ts';
import { resolverAccesoIa } from '../../lib/orgs/acceso.ts';
import { NOMBRE_TALLER } from '../../lib/taller/prompt.ts';
import { billingNow } from '../../lib/env.ts';

// El middleware ya garantiza sesión en /app/**; esto es sólo para el tipo.
const user = Astro.locals.user!;

/**
 * odd/tasks/organizaciones.md (T2, decisión del dueño — "Cuenta personal"):
 * quien no puede usar la IA y no es superadmin ve la pantalla de cuenta
 * personal acá en vez de la lista de recursos. Sus recursos NO se borran —
 * sólo dejan de listarse mientras la cuenta es personal.
 */
const accesoIa = await resolverAccesoIa(user);
const bloqueada = !accesoIa.allowed && user.role !== 'ADMIN';

// T4b: aviso de renovación del plan Individual anual (`resolverAccesoIa`,
// arriba, ya corrió `ensureGrants` → reconcilió un vencimiento sin renovar).
let avisoRenovacion: { currentPeriodEnd: Date } | null = null;
if (user.organizationId === null) {
  const suscripcion = await prisma.individualSubscription.findUnique({
    where: { userId: user.id },
    select: { status: true, interval: true, currentPeriodEnd: true },
  });
  const TREINTA_DIAS_MS = 30 * 24 * 60 * 60 * 1000;
  if (
    suscripcion?.status === 'ACTIVE' &&
    suscripcion.interval === 'ANNUAL' &&
    billingNow().getTime() >= suscripcion.currentPeriodEnd.getTime() - TREINTA_DIAS_MS
  ) {
    avisoRenovacion = { currentPeriodEnd: suscripcion.currentPeriodEnd };
  }
}

/**
 * A propósito `{ userId: user.id }` y NO `findProjectForActor`: esto lista
 * los recursos PROPIOS de quien mira, nunca un chequeo de propiedad. Un
 * admin navegando /app tiene que ver sus propios recursos, igual que
 * cualquier docente — no los de todo el mundo (M8, design.md §7, trampa
 * explícita de tasks.md 8.4).
 */
const projects = bloqueada
  ? []
  : await prisma.project.findMany({
      where: { userId: user.id },
      orderBy: { updatedAt: 'desc' },
      select: {
        id: true,
        title: true,
        description: true,
        slug: true,
        isInGallery: true,
        screenshotUrl: true,
        updatedAt: true,
        lastAdminActionAt: true,
      },
    });

/**
 * odd/tasks/taller-de-ideas.md: las ideas del Taller que todavía no se
 * convirtieron en recurso, para invitar a retomarlas desde acá.
 */
const ideasEnCurso = bloqueada
  ? 0
  : await prisma.ideaSession.count({ where: { userId: user.id, projectId: null } });

/** "Bajo una semana" (design.md §7): pasado ese punto, la marca desaparece sola. */
const SEMANA_MS = 7 * 24 * 60 * 60 * 1000;
function editadoPorAdministracion(fecha: Date | null): boolean {
  return fecha !== null && Date.now() - fecha.getTime() < SEMANA_MS;
}
---

<BaseLayout title="Mis recursos">
  {bloqueada ? (
    <CuentaPersonal acceso={accesoIa} />
  ) : (
    <>
  {avisoRenovacion && (
    <AvisoRenovacion
      periodEnd={avisoRenovacion.currentPeriodEnd}
      etiqueta="Tu plan Individual anual"
      siguienteEtiqueta="el próximo año"
      endpoint="/api/billing/individual/renovar"
    />
  )}
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-ink-900">Mis recursos</h1>
      <p class="mt-1 text-sm text-ink-500">
        {user.role === 'ADMIN' ? 'Administración · ' : ''}{user.email}
      </p>
    </div>

    <NewProjectButton client:load />
  </div>

  {/* odd/tasks/taller-de-ideas.md: la entrada al Taller desde el panel. */}
  <a
    href="/app/taller"
    class="kodu-card mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 p-4 transition-colors hover:border-brand-300"
  >
    <span class="min-w-0 flex-1">
      <span class="block font-semibold text-ink-900">{NOMBRE_TALLER}</span>
      <span class="mt-0.5 block text-sm text-ink-500">
        {ideasEnCurso > 0
          ? `Tenés ${ideasEnCurso === 1 ? 'una idea en camino. Retomala' : `${ideasEnCurso} ideas en camino. Retomalas`} cuando quieras, o pensá una nueva con Kodu.`
          : '¿Sabés qué vas a dar pero no qué herramienta usar? Pensala con Kodu antes de crearla: te pregunta, te propone ideas y arma el pedido por vos.'}
      </span>
    </span>
    <span class="kodu-btn-ghost shrink-0">{ideasEnCurso > 0 ? 'Ver mis ideas' : 'Pensar una idea'}</span>
  </a>

  {
    projects.length === 0 ? (
      <div class="kodu-card mt-6 p-10 text-center">
        <h2 class="text-lg font-semibold text-ink-900">Todavía no creaste recursos</h2>
        <p class="mx-auto mt-2 max-w-md text-sm text-ink-500">
          Tocá <strong>Nuevo recurso</strong> y describile a la IA la actividad que necesitás: la vas
          a ver armarse en vivo en el panel de vista previa. Si todavía no sabés qué pedir, empezá por el
          <a href="/app/taller" class="font-medium text-brand-600 hover:underline">{NOMBRE_TALLER}</a>.
        </p>
      </div>
    ) : (
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => (
          <li class="kodu-card flex flex-col overflow-hidden">
            <a href={`/app/project/${project.id}`} class="block">
              {project.screenshotUrl ? (
                <img
                  src={project.screenshotUrl}
                  alt={`Captura de ${project.title}`}
                  class="h-36 w-full border-b border-linea object-cover object-top"
                  loading="lazy"
                />
              ) : (
                <div class="grid h-36 w-full place-items-center border-b border-linea bg-sutil text-xs text-ink-500">
                  Sin captura
                </div>
              )}
            </a>

            <div class="flex flex-1 flex-col p-4">
              <a href={`/app/project/${project.id}`} class="font-semibold text-ink-900 hover:text-brand-600">
                {project.title}
              </a>
              {project.description && (
                <p class="mt-1 line-clamp-2 text-xs text-ink-500">{project.description}</p>
              )}

              <p class="mt-3 flex items-center gap-1.5 text-xs text-ink-500">
                <span
                  class={`inline-block h-1.5 w-1.5 shrink-0 rounded-full ${
                    project.isInGallery ? 'bg-brand-600' : 'bg-linea'
                  }`}
                  aria-hidden="true"
                />
                {project.isInGallery ? 'En la galería' : 'Privado'} ·{' '}
                {project.updatedAt.toLocaleDateString('es-AR')}
              </p>

              {/* Marca durable de M8 (design.md §7): sólo mientras es reciente
                  — pasada la semana, se apaga sola, no hace falta borrar nada. */}
              {editadoPorAdministracion(project.lastAdminActionAt) && (
                <p class="mt-1 text-xs text-brand-600">
                  Editado por administración · {haceTiempo(project.lastAdminActionAt)}
                </p>
              )}

              <div class="mt-3 flex items-center gap-3 border-t border-linea pt-3 text-xs">
                <a
                  href={`/app/project/${project.id}`}
                  class="rounded-lg bg-brand-600 px-2.5 py-1.5 font-semibold text-white transition-colors hover:bg-brand-700"
                >
                  Editar
                </a>
                <a
                  href={`/p/${project.slug}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-lg border border-linea px-2.5 py-1.5 font-medium text-ink-700 transition-colors hover:border-ink-500"
                >
                  Ver
                </a>
                <span class="ml-auto">
                  <ProjectCardActions client:visible projectId={project.id} title={project.title} />
                </span>
              </div>
            </div>
          </li>
        ))}
      </ul>
    )
  }
    </>
  )}
</BaseLayout>
