---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CuentaPersonal from '../../../components/CuentaPersonal.astro';
import EditorDelRecurso from '../../../components/workspace/EditorDelRecurso.astro';
import { findWorkspaceProjectForActor } from '../../../lib/projects.ts';
import { puedeUsarLaIa } from '../../../lib/orgs/acceso.ts';

const user = Astro.locals.user!;

// M8 (design.md §7): un ADMIN entra acá aunque no sea el dueño — es el único
// punto que decide eso, ver src/lib/projects.ts. Un DOCENTE (incluida la
// demo) sigue viendo exactamente el chequeo de siempre.
const project = await findWorkspaceProjectForActor(Astro.params.id!, user);

if (!project) {
  return Astro.redirect('/app', 302);
}

/**
 * odd/tasks/organizaciones.md (T2, decisión del dueño — "Cuenta personal"):
 * quien no puede usar la IA y no es superadmin ve la pantalla de cuenta
 * personal en vez del editor — nunca Workspace.tsx/ChatPanel.tsx (otra
 * sesión los cambia en paralelo). El recurso sigue existiendo: no se borra,
 * sólo deja de ser editable mientras la cuenta es personal.
 */
const bloqueada = !(await puedeUsarLaIa(user)) && user.role !== 'ADMIN';
---

<BaseLayout title={project.title} description={project.description ?? undefined} wide compactMobile>
  {bloqueada ? <CuentaPersonal /> : <EditorDelRecurso project={project} user={user} />}
</BaseLayout>
