---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Workspace from '../../../components/workspace/Workspace.tsx';
import IndicadorConsumo from '../../../components/workspace/IndicadorConsumo.tsx';
import BannerAdmin from '../../../components/admin/BannerAdmin.astro';
import { prisma } from '../../../lib/db.ts';
import { getEnv } from '../../../lib/env.ts';
import { findWorkspaceProjectForActor, portadaDesactualizada } from '../../../lib/projects.ts';
import { motoresParaDocente, normalizarMotor } from '../../../lib/ai/catalogo.ts';
import { costoPorProyecto, nivelDeConsumo } from '../../../lib/ai/usage.ts';

const user = Astro.locals.user!;

// M8 (design.md §7): un ADMIN entra acá aunque no sea el dueño — es el único
// punto que decide eso, ver src/lib/projects.ts. Un DOCENTE (incluida la
// demo) sigue viendo exactamente el chequeo de siempre.
const project = await findWorkspaceProjectForActor(Astro.params.id!, user);

if (!project) {
  return Astro.redirect('/app', 302);
}

/** Un admin mirando el recurso de OTRA persona — nunca el propio. */
const actuaComoAdminAjeno = user.role === 'ADMIN' && user.id !== project.userId;

// Un proyecto siempre nace con un hilo, pero si alguien borró todos, creamos uno.
const activeThread =
  project.threads[0] ??
  (await prisma.chatThread.create({
    data: { projectId: project.id },
    select: { id: true, title: true },
  }));

const messages = await prisma.chatMessage.findMany({
  where: { threadId: activeThread.id },
  orderBy: { createdAt: 'asc' },
  select: {
    id: true,
    role: true,
    content: true,
    attachments: true,
    createdAt: true,
    // Quién escribió el turno cuando no fue el dueño (M8, design.md §7).
    // `null` en el caso normal — no viaja ningún nombre de más.
    authorUser: { select: { name: true } },
  },
});

const siteUrl = getEnv().PUBLIC_SITE_URL;

// Los motores que puede elegir un docente, ya en el orden que configuró un
// admin (M3 los administra; acá sólo se leen).
const motoresDisponibles = await motoresParaDocente();

// El motor vigente del proyecto puede no existir más, estar apagado, o el
// proyecto puede ser nuevo y no tener ninguno todavía: `normalizarMotor` cae
// al default vigente en cualquiera de esos casos (design.md §5).
//
// `motorOriginal` se guarda ANTES de pisar `aiModelId`: separa dos casos que
// persisten igual (M2, ya probado por e2e/m2-catalogo.ts) pero que NO avisan
// igual:
//  - proyecto nuevo sin motor todavía (`motorOriginal` null) → primera
//    asignación, se persiste calladito, nunca es un "repunteo";
//  - proyecto que SÍ tenía un motor y dejó de estar disponible
//    (`motorOriginal` no null) → repunteo real, spec `ai-model-catalog`
//    ("Fallback when a project's model is disabled") pide avisar.
const motorOriginal = project.aiModelId;
const motorVigente = await normalizarMotor(project.aiModelId);
const aiModelId = motorVigente?.id ?? project.aiModelId ?? '';
const motorCambio = !!motorVigente && motorVigente.id !== motorOriginal;

if (motorCambio && motorVigente) {
  await prisma.project.update({ where: { id: project.id }, data: { aiModelId: motorVigente.id } });
}

// El aviso se muestra UNA vez porque el `update` de arriba ya persistió el
// nuevo `aiModelId`: la próxima carga de esta misma página, `motorOriginal`
// va a ser igual a `motorVigente.id`, `motorCambio` va a dar `false` solo, y
// esta cuenta también. No hace falta ninguna columna nueva ni timestamp de
// "ya lo vio" (M2 lo había diferido a M3; M3 nunca lo retomó, se cierra acá).
const avisoDeMotorRepunteado =
  motorCambio && motorOriginal !== null
    ? 'Cambiamos el motor de este proyecto porque el anterior ya no está disponible.'
    : null;

// Si ningún motor quedó marcado "para el docente" (todavía sin configurar, o
// todos apagados salvo el vigente), igual se muestra el que está en uso: un
// selector vacío es peor que uno con una sola opción.
const motoresParaElSelector =
  motoresDisponibles.length > 0
    ? motoresDisponibles
    : motorVigente
      ? [
          {
            id: motorVigente.id,
            displayName: motorVigente.label,
            description: null,
            supportsVision: motorVigente.supportsVision,
          },
        ]
      : [];

// El consumo del recurso (design.md — "The workspace cost indicator"): se
// calcula acá, en el frontmatter, no en el cliente — así se refresca cuando
// la página se refresca y no anda pidiendo datos aparte. Ausente entero
// cuando no hay ningún turno registrado (nunca un indicador en "0").
const consumoDelRecurso = await costoPorProyecto(project.id);
const nivelDeConsumoDelRecurso = nivelDeConsumo(consumoDelRecurso.tokens);
---

<BaseLayout title={project.title} description={project.description ?? undefined} wide>
  {/* La miga de pan generica (flechita, barra, titulo) no decia nada. Ahora el
      volver es una pieza tactil —la flecha se corre sola al pasar por encima— y
      el titulo se escribe en la tipografia de la marca, que es lo unico que
      identifica de verdad a este recurso. */}
  <div class="mb-3 flex items-center gap-3">
    <a
      href="/app"
      class="group inline-flex items-center gap-2 rounded-full border border-linea bg-superficie py-1 pr-3.5 pl-1 text-sm text-ink-700 transition-colors hover:border-brand-300 hover:text-brand-600"
    >
      <span
        class="grid h-6 w-6 place-items-center rounded-full bg-sutil transition-all group-hover:-translate-x-0.5 group-hover:bg-brand-50"
      >
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path
            d="M7.5 2.5 4 6l3.5 3.5"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>
      Mis recursos
    </a>

    <span class="h-4 w-px shrink-0 bg-linea" aria-hidden="true"></span>

    <h1 class="font-display truncate text-sm tracking-tight text-ink-900 uppercase">
      {project.title}
    </h1>

    {/* No dentro de ChatPanel: el indicador vive en la miga de pan, a
        distancia de la columna donde está la atención (design.md). Ausente
        por completo cuando el recurso todavía no gastó nada. */}
    {consumoDelRecurso.tokens > 0 && (
      <IndicadorConsumo
        client:load
        tokens={consumoDelRecurso.tokens}
        nivel={nivelDeConsumoDelRecurso}
      />
    )}
  </div>

  {/* M8 (design.md §7): sólo cuando el admin no es el dueño. Un docente en
      su propio recurso — incluida la demo — nunca la ve. */}
  {actuaComoAdminAjeno && (
    <BannerAdmin ownerName={project.user.name} backHref={`/admin/usuarios/${project.userId}`} />
  )}

  <Workspace
    client:load
    project={{
      id: project.id,
      title: project.title,
      description: project.description,
      slug: project.slug,
      currentHtml: project.currentHtml,
      aiModelId,
      isInGallery: project.isInGallery,
      screenshotUrl: project.screenshotUrl,
      portadaVieja: portadaDesactualizada(project.screenshotAt, project.updatedAt),
    }}
    threads={project.threads.length > 0 ? project.threads : [activeThread]}
    activeThreadId={activeThread.id}
    messages={messages.map((message) => ({
      id: message.id,
      role: message.role,
      content: message.content,
      attachments: message.attachments ? (JSON.parse(message.attachments) as string[]) : [],
      createdAt: message.createdAt.getTime(),
      authorName: message.authorUser?.name ?? null,
    }))}
    assets={project.assets}
    siteUrl={siteUrl}
    authorName={user.name}
    motoresDisponibles={motoresParaElSelector}
    initialNotice={avisoDeMotorRepunteado}
  />
</BaseLayout>
