---
import BaseLayout from '../layouts/BaseLayout.astro';

const user = Astro.locals.user;
---

<BaseLayout title="KoduEdu">
  <section class="mx-auto max-w-3xl py-12 text-center">
    <p class="text-sm font-semibold tracking-wide text-brand-600 uppercase">
      Plataforma institucional
    </p>
    <h1 class="mt-3 text-4xl font-bold text-balance text-ink-900 sm:text-5xl">
      Recursos didácticos interactivos, creados conversando
    </h1>
    <p class="mt-4 text-lg text-pretty text-ink-500">
      Describí la actividad que necesitás y KoduEdu la convierte en un quiz, un simulador o una
      calculadora lista para proyectar y compartir con tus estudiantes.
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      {
        user ? (
          <a href="/app" class="kodu-btn-primary">
            Ir a mis recursos
          </a>
        ) : (
          <>
            <a href="/register" class="kodu-btn-primary">
              Crear cuenta institucional
            </a>
            <a href="/login" class="kodu-btn-ghost">
              Ya tengo cuenta
            </a>
          </>
        )
      }
    </div>
  </section>
</BaseLayout>
