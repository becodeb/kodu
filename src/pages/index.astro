---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ejemplos } from '../lib/ejemplos';
import '../styles/landing.css';
const user = Astro.locals.user;
const empezar = user ? '/app/taller' : '/register';
---
<BaseLayout title="Kodu" description="Tu forma de enseñar, con nuevas posibilidades. Aportá tu experiencia docente y creá recursos interactivos con Kodu, sin barreras tecnológicas." bare bleed>
  <div class="landing">
    <header class="landing-nav wrap">
      <a class="brand" href="/" aria-label="Kodu, inicio"><img src="/brand/kodu-logo.webp" width="420" height="158" alt="Kodu" /></a>
      <nav aria-label="Navegación principal"><a href="#como-funciona">Cómo funciona</a><a href="/gallery">Explorar recursos</a><a href="#instituciones">Para instituciones</a><a href="/precios">Precios</a></nav>
      <div class="nav-actions"><a href={user ? '/app' : '/login'}>{user ? 'Mis recursos' : 'Ingresar'}</a><a class="action primary" href={empezar}>Empezar <span aria-hidden="true">↗</span></a></div>
    </header>
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero-copy">
        <p class="eyebrow">TU MIRADA DOCENTE. NUEVAS POSIBILIDADES.</p>
        <h1 id="hero-title">Tu forma de enseñar, <br />con <span>nuevas posibilidades.</span></h1>
        <p class="hero-description">Vos aportás tu experiencia y el propósito de cada clase. Kodu los transforma en recursos interactivos y se ocupa de la tecnología.</p>
        <div class="hero-actions"><a class="action primary" href={empezar}>Empezar con mi idea <span aria-hidden="true">→</span></a><a class="text-link" href="#demo">Probar un ejemplo <span aria-hidden="true">↘</span></a></div>
      </div>
      <div class="product wrap" id="demo">
        <div class="browser-bar"><span class="browser-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>Una idea de clase, hecha recurso</span><a id="demo-open" href="/p/kodu-ejemplo-celula" target="_blank" rel="noopener noreferrer">Abrir recurso <span aria-hidden="true">↗</span></a></div>
        <div class="product-toolbar"><span class="mini-brand">Kodu<span aria-hidden="true">✦</span></span><div class="demo-tabs" role="group" aria-label="Elegir recurso de ejemplo"><button type="button" data-demo="celula" aria-pressed="true">Célula animal</button><button type="button" data-demo="funciones" aria-pressed="false">Funciones</button></div></div>
        <div class="product-body">
          <aside class="conversation" aria-label="Ejemplo de intercambio con Kodu">
            <p class="conversation-label">EL CRITERIO LO PONÉS VOS</p>
            <div class="message teacher"><span class="avatar">D</span><div><strong>Tu idea</strong><p id="brief">Trabajo con 7.º grado. Quiero que comparen las funciones de los organelos y expliquen cómo se relacionan. Primero, que puedan explorar.</p></div></div>
            <div class="message"><span class="avatar kodu-avatar">✦</span><div><strong>Kodu</strong><p id="reply">Armé un modelo para explorar cada parte de la célula, comparar sus funciones y descubrir cómo trabajan juntas.</p></div></div>
            <div class="message teacher"><span class="avatar">D</span><div><strong>Tu ajuste</strong><p id="refinement">Sumá un desafío con pistas. Si se equivocan, que puedan volver a intentarlo.</p></div></div>
            <div class="message"><span class="avatar kodu-avatar">✦</span><div><strong>Kodu</strong><p id="result">Listo. Probá el desafío: cada respuesta tiene una devolución para seguir aprendiendo.</p></div></div>
            <a class="conversation-start" href={empezar}>¿Cómo sería para tu clase? <span aria-hidden="true">→</span></a>
          </aside>
          {/* Sólo ejemplos editoriales versionados en el repo, nunca HTML de usuarios.
              El origen permite cargar sus imágenes en el servidor de desarrollo de Astro. */}
          <div class="live-resource"><iframe id="live-demo" src="/p/kodu-ejemplo-celula" title="Célula animal: recurso interactivo de ejemplo" sandbox="allow-scripts allow-same-origin" loading="eager"></iframe></div>
        </div>
        <div class="product-caption"><span class="live-dot" aria-hidden="true"></span> Es interactivo de verdad. Tocá un organelo y explorá.<span>Ejemplo de recurso · 7.º grado</span></div>
      </div>
    </section>
    <section class="purpose wrap" id="como-funciona">
      <span class="spark" aria-hidden="true">✦</span>
      <h2>Que tu forma de enseñar llegue más lejos.<br /><span>Sin barreras tecnológicas.</span></h2>
      <div class="steps">
        <article><span class="step-number">01</span><h3>Aportá tu mirada</h3><p>Contá quiénes son tus estudiantes, qué querés que aprendan y cómo te gustaría enseñar. Cuanto más contexto, más tuyo será el recurso.</p></article>
        <article><span class="step-number">02</span><h3>Creá y ajustá</h3><p>Explorá lo que va tomando forma. Probá, pedí cambios y afiná la propuesta con tu criterio docente. Crear también es volver a mirar.</p></article>
        <article><span class="step-number">03</span><h3>Compartí con tu clase</h3><p>Tu recurso queda listo para abrir con un enlace. Kodu resuelve el código, el alojamiento y la dirección web para que vos te enfoques en enseñar.</p></article>
      </div>
    </section>
    <section class="resources wrap" aria-labelledby="resources-title">
      <div class="section-heading"><div><p class="eyebrow">DE LA IDEA A LA EXPERIENCIA</p><h2 id="resources-title">Recursos con intención pedagógica.</h2></div><a class="text-link" href="/gallery">Explorar la galería <span aria-hidden="true">→</span></a></div>
      <div class="resource-grid">
        {ejemplos.map((ejemplo) => <a class="resource-card" href={ejemplo.url} target="_blank" rel="noopener noreferrer"><div class="resource-image"><img src={ejemplo.imagen} alt={ejemplo.alt} width="900" height="600" loading="lazy" /><span>{ejemplo.area}</span></div><div class="resource-copy"><h3>{ejemplo.titulo}</h3><p>{ejemplo.descripcion}</p><span class="card-arrow" aria-hidden="true">↗</span></div></a>)}
      </div>
    </section>
    <section class="institutions wrap" id="instituciones"><div><p class="eyebrow">PARA COLEGIOS Y REDES EDUCATIVAS</p><h2>Una comunidad que crea<br />desde lo que sabe.</h2></div><div><p>Un espacio para que cada docente transforme su experiencia en recursos y comparta nuevas posibilidades con su comunidad educativa.</p><a class="text-link" href={user ? '/app' : '/register'}>Conocer mi espacio en Kodu <span aria-hidden="true">→</span></a> <a class="text-link" href="/precios">Ver planes para instituciones <span aria-hidden="true">→</span></a></div></section>
    <section class="closing"><div class="wrap"><span class="spark" aria-hidden="true">✦</span><h2>La próxima idea<br />empieza con vos.</h2><p>Tu experiencia puede abrir nuevas formas de aprender.</p><a class="action yellow" href={empezar}>Empezar con mi idea <span aria-hidden="true">→</span></a></div></section>
    <footer class="landing-footer wrap"><a href="/" class="mini-brand">Kodu<span aria-hidden="true">✦</span></a><p>Tecnología al servicio de tu forma de enseñar.</p><a href="/gallery">Explorar recursos ↗</a></footer>
  </div>
</BaseLayout>
<script>
  const frame = document.querySelector<HTMLIFrameElement>('#live-demo');
  const open = document.querySelector<HTMLAnchorElement>('#demo-open');
  const caption = document.querySelector('.product-caption');
  // La demo es nuestra y vive en el mismo origen. Ajustar su alto evita
  // recortar actividades o obligar a hacer scroll dentro del celular.
  let observer: ResizeObserver | undefined;
  function fitExample() {
    observer?.disconnect();
    if (!frame) return;
    if (!frame.src.endsWith('/p/kodu-ejemplo-celula')) {
      frame.style.height = '520px';
      return;
    }
    const body = frame.contentDocument?.body;
    if (!body) return;
    const resize = () => { frame.style.height = Math.ceil(body.getBoundingClientRect().height) + 'px'; };
    observer = new ResizeObserver(resize);
    observer.observe(body);
    resize();
  }
  frame?.addEventListener('load', fitExample);
  if (frame?.contentDocument?.readyState === 'complete') fitExample();
  const scenarios = {
    celula: {url:'/p/kodu-ejemplo-celula',title:'Célula animal: recurso interactivo de ejemplo',brief:'Trabajo con 7.º grado. Quiero que comparen las funciones de los organelos y expliquen cómo se relacionan. Primero, que puedan explorar.',reply:'Armé un modelo para explorar cada parte de la célula, comparar sus funciones y descubrir cómo trabajan juntas.',refinement:'Sumá un desafío con pistas. Si se equivocan, que puedan volver a intentarlo.',result:'Listo. Probá el desafío: cada respuesta tiene una devolución para seguir aprendiendo.',caption:'Es interactivo de verdad. Tocá un organelo y explorá.',level:'Ejemplo de recurso · 7.º grado'},
    funciones: {url:'/demos/explorador-funciones.html',title:'Funciones: graficador interactivo de ejemplo',brief:'En 4.º año estamos estudiando funciones. Quiero que formulen hipótesis sobre los coeficientes y las comprueben moviendo la curva.',reply:'Preparé un graficador con controles para explorar cómo cambia cada función.',refinement:'Que puedan comparar una cuadrática, una función seno y una exponencial, y observar sus puntos importantes.',result:'Probá los controles del graficador y cambiá de función. Cada modificación se ve al instante.',caption:'Es interactivo de verdad. Mové los coeficientes y compará.',level:'Ejemplo de recurso · 4.º año'}
  };
  document.querySelectorAll<HTMLButtonElement>('[data-demo]').forEach(button => button.addEventListener('click', () => {
    const scene = scenarios[button.dataset.demo as keyof typeof scenarios];
    if (!scene || !frame || !open || !caption) return;
    document.querySelectorAll('[data-demo]').forEach(other => other.setAttribute('aria-pressed', String(other === button)));
    frame.src = scene.url; frame.title = scene.title; open.href = scene.url;
    for (const id of ['brief','reply','refinement','result'] as const) { const el = document.getElementById(id); if (el) el.textContent = scene[id]; }
    caption.replaceChildren();
    const dot = document.createElement('span'); dot.className = 'live-dot'; dot.setAttribute('aria-hidden','true');
    const level = document.createElement('span'); level.textContent = scene.level;
    caption.append(dot, document.createTextNode(scene.caption), level);
  }));
</script>
