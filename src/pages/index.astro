---
import BaseLayout from '../layouts/BaseLayout.astro';
import { prisma } from '../lib/db.ts';

const user = Astro.locals.user;

/**
 * Los tres recursos del visor viven en /public/demos y son interactivos de
 * verdad: se pueden usar desde la home sin crear cuenta.
 */
const demos = [
  {
    slug: 'celula-3d',
    area: 'Biología',
    anio: '7.º grado',
    pedido:
      'Una célula animal en 3D que se pueda girar, y que al tocar cada organelo explique qué hace.',
    respuesta:
      'Listo. La armé en 3D con giro libre; cada organelo es clickeable y muestra su función al costado.',
  },
  {
    slug: 'explorador-funciones',
    area: 'Matemática',
    anio: '4.º año',
    pedido:
      'Un graficador donde pueda mover los coeficientes y la escala, y ver cómo cambia la curva en vivo.',
    respuesta:
      'Hecho: cuadrática, seno y exponencial, con controles para a, b, c y zoom. Marca las raíces y el vértice.',
  },
  {
    slug: 'tiro-oblicuo',
    area: 'Física',
    anio: '5.º año',
    pedido:
      'Un simulador de tiro oblicuo con ángulo y velocidad regulables, que compare la Tierra con la Luna.',
    respuesta:
      'Ahí está: cambiás ángulo, velocidad y planeta, y quedan dibujados los tiros anteriores para comparar.',
  },
];

const hechos = [
  'Sin instalar nada, corre en el navegador',
  'Los estudiantes no necesitan cuenta',
  'Los recursos quedan en el servidor de la red',
];

const pasos = [
  {
    titulo: 'Escribís el pedido',
    detalle:
      'El tema, el año y qué querés que haga. En castellano, como se lo explicarías a un colega.',
  },
  {
    titulo: 'Lo ves armarse',
    detalle:
      'El recurso aparece al lado del chat mientras se genera. Si algo no va, se lo pedís distinto y lo rehace.',
  },
  {
    titulo: 'Lo llevás al aula',
    detalle: 'Proyectás la vista pública o pasás el link. Abre en cualquier compu, tablet o celular.',
  },
];

const ideas = [
  { area: 'Química', texto: 'Una tabla periódica que muestre las propiedades al tocar cada elemento.' },
  { area: 'Historia', texto: 'Una línea de tiempo de la Revolución de Mayo con los hitos desplegables.' },
  { area: 'Geografía', texto: 'Un mapa de provincias para practicar capitales, con puntaje.' },
  { area: 'Lengua', texto: 'Un analizador de oraciones donde se arrastre cada parte a su lugar.' },
  { area: 'Inglés', texto: 'Flashcards de vocabulario con repetición espaciada.' },
  { area: 'Economía', texto: 'Un simulador de interés compuesto con montos y plazos regulables.' },
];

const publicados = await prisma.project.findMany({
  where: { isInGallery: true },
  orderBy: { updatedAt: 'desc' },
  take: 3,
  select: {
    title: true,
    description: true,
    slug: true,
    screenshotUrl: true,
    user: { select: { name: true } },
  },
});
---

<BaseLayout title="Kodu" bleed>
  <!-- ── Portada ──────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden bg-superficie">
    {/* La chispa del logo, en el angulo. El titular ocupa la mitad izquierda y
        dejaba todo este lado vacio; la marca lo llena sin competirle, porque es
        la unica pieza de la identidad que no es tipografia. */}
    <svg
      class="pointer-events-none absolute -top-6 -right-6 h-40 w-40 select-none sm:-top-10 sm:-right-10 sm:h-64 sm:w-64 lg:h-80 lg:w-80"
      viewBox="0 0 100 100"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M50 0 C52 30 70 48 100 50 C70 52 52 70 50 100 C48 70 30 52 0 50 C30 48 48 30 50 0 Z"
        fill="#fcb547"
      />
    </svg>

    <div class="relative mx-auto max-w-6xl px-6 pt-16 pb-14 sm:pt-24">
    <h1
      class="font-display text-[clamp(3rem,10vw,8.5rem)] leading-[0.86] tracking-[-0.045em] uppercase"
    >
      Pedilo<br />en una<br /><span class="text-brand-600">frase</span>
    </h1>

    <div class="mt-12 grid gap-10 border-t border-linea pt-7 lg:grid-cols-2">
      <p class="max-w-[44ch] text-lg leading-relaxed text-ink-700 sm:text-xl">
        Kodu toma la actividad que describís y la devuelve funcionando: una célula que se gira, un
        graficador que responde a los controles, un simulador de física. Lista para proyectar en el
        aula o compartir por link.
      </p>

      <div>
        <ol class="space-y-3">
          {
            hechos.map((hecho, i) => (
              <li class="flex gap-4 text-[0.95rem] text-ink-500">
                <span class="font-display text-ink-900">{String(i + 1).padStart(2, '0')}</span>
                {hecho}
              </li>
            ))
          }
        </ol>

        <div class="mt-7 flex flex-wrap gap-3">
          {
            user ? (
              <a href="/app" class="kodu-btn-carbon">
                Ir a mis recursos
              </a>
            ) : (
              <>
                <a href="/register" class="kodu-btn-carbon">
                  Crear cuenta institucional
                </a>
                <a href="/login" class="kodu-btn-ghost">
                  Ya tengo cuenta
                </a>
              </>
            )
          }
        </div>
      </div>
    </div>
  </div></section>

  <!-- ── El editor, escribiéndose solo ────────────────────────────────── -->
  <section class="border-y border-linea bg-lienzo">
    <div class="mx-auto max-w-[92rem] px-6 py-14">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold tracking-[0.14em] text-ink-500 uppercase">Así se usa</p>
          <h2
            class="font-display mt-2 text-3xl leading-none tracking-[-0.03em] uppercase sm:text-4xl"
          >
            El pedido, y lo que sale
          </h2>
        </div>
        <p class="max-w-[38ch] text-sm text-ink-500">
          Los tres recursos son reales y andan. Tocá otro pedido para verlo aparecer.
        </p>
      </div>

      <div class="mt-7 grid gap-3 lg:grid-cols-[22rem_1fr]">
        <div
          class="flex h-[26rem] flex-col overflow-hidden rounded-[10px] border border-linea bg-superficie lg:h-[34rem]"
        >
          <div
            class="flex items-center justify-between border-b border-linea px-4 py-2.5 text-xs text-ink-500"
          >
            <span>Conversación</span><span>Flash</span>
          </div>
          <div id="mensajes" class="flex flex-1 flex-col gap-3 overflow-auto p-4"></div>
          <div class="flex items-center gap-2 border-t border-linea p-3">
            <div
              id="campo"
              class="min-h-[2.5rem] flex-1 rounded-lg border border-linea px-3 py-2 text-sm text-ink-500"
            >
            </div>
            <span class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white">
              Enviar
            </span>
          </div>
        </div>

        <div
          class="flex h-[26rem] flex-col overflow-hidden rounded-[10px] border border-linea bg-superficie lg:h-[34rem]"
        >
          <div
            class="flex items-center justify-between border-b border-linea px-4 py-2.5 text-xs text-ink-500"
          >
            <span id="url" class="truncate font-mono">kodu.becode.com.ar/p/…</span>
            <span class="pl-3">Vista previa</span>
          </div>
          <div
            id="espera"
            class="grid flex-1 place-items-center p-8 text-center text-sm text-ink-500"
          >
            Acá aparece el recurso, mientras se escribe el pedido.
          </div>
          <iframe
            id="visor"
            title="Recurso de ejemplo, interactivo"
            sandbox="allow-scripts"
            class="hidden w-full flex-1 border-0"></iframe>
        </div>
      </div>

      <div class="mt-3 grid gap-2 sm:grid-cols-3">
        {
          demos.map((demo, i) => (
            <button
              type="button"
              class="demo-tab rounded-[10px] border border-linea bg-superficie p-3.5 text-left transition-colors hover:border-ink-500"
              data-slug={demo.slug}
              data-pedido={demo.pedido}
              data-respuesta={demo.respuesta}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              <span class="text-[0.7rem] font-semibold tracking-[0.1em] text-brand-600 uppercase">
                {demo.area} · {demo.anio}
              </span>
              <span class="mt-1 block text-sm leading-snug text-ink-700">{demo.pedido}</span>
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Cómo funciona ────────────────────────────────────────────────── -->
  <section class="bg-superficie"><div class="mx-auto max-w-6xl px-6 py-20">
    <h2 class="font-display text-3xl leading-none tracking-[-0.03em] uppercase sm:text-4xl">
      Tres pasos
    </h2>

    <ol class="mt-10 grid gap-8 sm:grid-cols-3">
      {
        pasos.map((paso, i) => (
          <li class="border-t-2 border-ink-900 pt-4">
            <span class="font-display text-2xl tracking-[-0.03em]">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-1.5 font-semibold text-ink-900">{paso.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">{paso.detalle}</p>
          </li>
        ))
      }
    </ol>
  </div></section>

  <!-- ── Ideas ────────────────────────────────────────────────────────── -->
  <section class="border-y border-linea bg-lienzo">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="font-display text-3xl leading-none tracking-[-0.03em] uppercase sm:text-4xl">
          Qué se le puede pedir
        </h2>
        <p class="max-w-[40ch] text-sm text-ink-500">
          No hay fórmula: se pide como se habla. Estos sirven para arrancar.
        </p>
      </div>

      <ul class="mt-8 grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3">
        {
          ideas.map((idea) => (
            <li class="rounded-[10px] border border-linea bg-superficie px-4 py-3.5">
              <span class="text-[0.7rem] font-semibold tracking-[0.1em] text-brand-600 uppercase">
                {idea.area}
              </span>
              <p class="mt-1 text-sm leading-snug text-ink-700">{idea.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── Galería ──────────────────────────────────────────────────────── -->
  <section class="bg-superficie"><div class="mx-auto max-w-6xl px-6 py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="font-display text-3xl leading-none tracking-[-0.03em] uppercase sm:text-4xl">
        Lo que publican los docentes
      </h2>
      <a href="/gallery" class="kodu-btn-ghost">Ver la galería</a>
    </div>

    {
      publicados.length === 0 ? (
        <p class="mt-8 rounded-[10px] border border-dashed border-linea bg-superficie px-6 py-12 text-center text-sm text-ink-500">
          Todavía no hay nada publicado. El primer recurso que compartas aparece acá.
        </p>
      ) : (
        <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {publicados.map((recurso) => (
            <li class="overflow-hidden rounded-[10px] border border-linea bg-superficie">
              <a href={`/p/${recurso.slug}`} target="_blank" rel="noopener noreferrer">
                {recurso.screenshotUrl ? (
                  <img
                    src={recurso.screenshotUrl}
                    alt={`Captura de ${recurso.title}`}
                    class="h-40 w-full border-b border-linea object-cover object-top"
                    loading="lazy"
                  />
                ) : (
                  <div class="grid h-40 place-items-center border-b border-linea bg-lienzo text-xs text-ink-500">
                    Sin captura
                  </div>
                )}
              </a>
              <div class="p-4">
                <h3 class="font-semibold text-ink-900">{recurso.title}</h3>
                <p class="mt-0.5 text-xs text-ink-500">por {recurso.user.name}</p>
                {recurso.description && (
                  <p class="mt-2 line-clamp-2 text-sm text-ink-700">{recurso.description}</p>
                )}
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </div></section>

  <!-- ── Cierre ───────────────────────────────────────────────────────── -->
  <section class="bg-carbon text-white">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <h2
        class="font-display max-w-[18ch] text-3xl leading-none tracking-[-0.03em] uppercase sm:text-5xl"
      >
        Con tu correo institucional alcanza
      </h2>

      <div class="mt-10 grid gap-8 border-t border-white/15 pt-8 lg:grid-cols-[1fr_auto] lg:items-end">
        <dl class="grid gap-6 sm:grid-cols-3">
          <div>
            <dt class="font-semibold">Acceso restringido</dt>
            <dd class="mt-1 text-sm text-white/60">
              Sólo los dominios de correo que habilita la administración.
            </dd>
          </div>
          <div>
            <dt class="font-semibold">Reglas para todos</dt>
            <dd class="mt-1 text-sm text-white/60">
              Criterios pedagógicos y de accesibilidad aplicados en cada generación.
            </dd>
          </div>
          <div>
            <dt class="font-semibold">Todo en la red</dt>
            <dd class="mt-1 text-sm text-white/60">
              La plataforma corre en el servidor de la institución, con su base de datos.
            </dd>
          </div>
        </dl>

        <a
          href={user ? '/app' : '/register'}
          class="text-carbon inline-flex items-center justify-center rounded-lg bg-superficie px-6 py-3 text-sm font-semibold"
        >
          {user ? 'Ir a mis recursos' : 'Crear cuenta'}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .demo-tab[aria-pressed='true'] {
    border-color: var(--color-ink-900);
    box-shadow: inset 0 0 0 1px var(--color-ink-900);
  }

  .cursor::after {
    content: '';
    display: inline-block;
    width: 1.5px;
    height: 1em;
    background: var(--color-brand-600);
    margin-left: 1px;
    vertical-align: -0.15em;
    animation: parpadeo 1s steps(1) infinite;
  }

  @keyframes parpadeo {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor::after {
      animation: none;
    }
  }
</style>

<script>
  // El panel de la izquierda escribe el pedido solo, como lo haría una docente,
  // y el resultado aparece a la derecha. Es la demostración del producto.
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.demo-tab'));
  const mensajes = document.querySelector<HTMLElement>('#mensajes');
  const campo = document.querySelector<HTMLElement>('#campo');
  const visor = document.querySelector<HTMLIFrameElement>('#visor');
  const espera = document.querySelector<HTMLElement>('#espera');
  const url = document.querySelector<HTMLElement>('#url');

  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const esperar = (ms: number) => new Promise((r) => window.setTimeout(r, ms));
  let corriendo = 0;

  function burbuja(quien: 'docente' | 'kodu', texto: string) {
    if (!mensajes) return null;
    const el = document.createElement('div');
    el.className =
      quien === 'docente'
        ? 'self-end max-w-[92%] rounded-xl rounded-br-sm bg-brand-600 px-3.5 py-2.5 text-sm leading-snug text-white'
        : 'self-start max-w-[92%] rounded-xl rounded-bl-sm bg-lienzo px-3.5 py-2.5 text-sm leading-snug text-ink-700';
    el.textContent = texto;
    mensajes.appendChild(el);
    mensajes.scrollTop = mensajes.scrollHeight;
    return el;
  }

  async function reproducir(tab: HTMLButtonElement) {
    const turno = ++corriendo;
    for (const otro of tabs) otro.setAttribute('aria-pressed', String(otro === tab));

    if (!mensajes || !campo || !visor || !espera || !url) return;

    mensajes.textContent = '';
    campo.textContent = '';
    visor.classList.add('hidden');
    espera.classList.remove('hidden');
    url.textContent = 'kodu.becode.com.ar/p/…';

    const pedido = tab.dataset.pedido ?? '';
    campo.classList.add('cursor');

    for (const letra of pedido) {
      if (turno !== corriendo) return;
      campo.textContent += letra;
      await esperar(reducido ? 0 : 16);
    }

    await esperar(320);
    if (turno !== corriendo) return;

    campo.classList.remove('cursor');
    campo.textContent = '';
    burbuja('docente', pedido);

    const pensando = burbuja('kodu', 'Escribiendo…');
    await esperar(900);
    if (turno !== corriendo) return;

    if (pensando) pensando.textContent = tab.dataset.respuesta ?? '';

    espera.classList.add('hidden');
    visor.classList.remove('hidden');
    visor.src = `/demos/${tab.dataset.slug}.html`;
    url.textContent = `kodu.becode.com.ar/p/${tab.dataset.slug}`;
  }

  for (const tab of tabs) tab.addEventListener('click', () => void reproducir(tab));

  // Arranca sola cuando la sección entra en pantalla.
  const primera = tabs[0];
  if (primera) {
    const seccion = primera.closest('section');
    const observador = new IntersectionObserver(
      (entradas) => {
        if (entradas.some((e) => e.isIntersecting)) {
          observador.disconnect();
          void reproducir(primera);
        }
      },
      { threshold: 0.2 },
    );
    if (seccion) observador.observe(seccion);
  }
</script>
