// KoduEdu — modelo de datos (SPEC.md §3)
// Prisma 7: el generador es "prisma-client" (ESM, con output explicito) y el
// cliente se instancia con un driver adapter (ver src/lib/db.ts).

datasource db {
  // La URL vive en prisma.config.ts (Prisma 7 la saca del schema).
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum Role {
  DOCENTE
  ADMIN
}

enum ModelChoice {
  /// Fuera de servicio desde 2026-08-27 (dejo de ser gratuito). Se conserva
  /// porque hay consumo historico que lo referencia.
  ALPHA
  /// Bajo llave: se paga por token y solo entra como respaldo automatico.
  DEEPSEEK
  /// MiniMax M3 servido por GMI Cloud; gratuito y multimodal.
  MINIMAX
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  /// Opcional: quien entra con Google no tiene contrasena en Kodu.
  passwordHash String?
  /// `sub` de Google. Identifica la cuenta aunque cambie el correo visible.
  googleId     String?      @unique
  name         String
  role         Role         @default(DOCENTE)
  /// Permiso individual de acceso a la IA (design.md #10). `null` = sin
  /// opinion, sigue la regla de dominio; `true` = habilitado a mano por un
  /// admin sin importar el dominio; `false` = revocado a mano sin importar
  /// el dominio. Hasta la migracion 20260921000000 esta columna se llamaba
  /// `deepseekEnabled` y contestaba otra pregunta (si el docente podia usar
  /// DeepSeek); sus valores `true` NO se heredan como permiso — la migracion
  /// los limpia a `null`.
  aiAccessOverride Boolean?
  /// Cuenta compartida de demo publica (design.md #8; specs/demo-mode).
  /// Ver el indice unico parcial en la migracion 20260922000000: a lo sumo
  /// una fila en true, igual que AiModel.isDefault.
  isDemo       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  projects     Project[]
  rules        CustomRule[]
  tokenUsage   TokenUsage[]
  /// "Me gusta" que este docente puso en recursos publicados de otros
  /// (o propios) en la galeria. Back-relation de ProjectLike.user.
  likes        ProjectLike[]
  /// M8 (design.md #7): recursos ajenos donde esta cuenta actuó como el
  /// último admin. Back-relation de Project.lastAdminActor.
  adminActedProjects Project[]    @relation("ProjectLastAdminActor")
  /// M8: turnos de chat que esta cuenta escribió actuando como admin sobre
  /// un recurso que no le pertenece. Back-relation de ChatMessage.authorUser.
  authoredMessages   ChatMessage[] @relation("ChatMessageAuthor")
}

/// Fila unica de interruptores de toda la app (design.md #9): hoy solo la
/// demo (M7), pero evita que el proximo toggle en tiempo de ejecucion tenga
/// que inventar donde vivir. Singleton, no clave-valor: se lee tipado, entero
/// y en pocos lugares por request — ver la justificacion completa en
/// design.md.
model AppSettings {
  id                 Int      @id @default(1) // CHECK (id = 1) en la migracion: jamas una segunda fila.
  demoEnabled        Boolean  @default(false)
  demoTokenLimit     Int      @default(200000)
  demoCycleStartedAt DateTime @default(now())
  /// odd/tasks/generacion-simple-y-reanudable.md: el único interruptor de
  /// "capa 1" que sobrevivió a la baja de modo prime — ver
  /// `src/lib/ai/capacidades.ts`.
  versionsForAll     Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

/// Dominios de correo que habilitan el uso de la IA (design.md #10) — NO el
/// registro ni el login, que quedan abiertos a cualquiera desde M6. Reemplaza
/// a `ALLOWED_EMAIL_DOMAINS` como fuente de verdad en tiempo de ejecucion; el
/// env var solo se usa como semilla inicial (`prisma/seed.ts`).
model AuthorizedDomain {
  id        String   @id @default(uuid())
  /// "rededucativa.edu.ar" o "*.edu.ar" (comodin de subdominio). Siempre en
  /// minusculas, sin "@".
  pattern   String   @unique
  note      String?
  createdAt DateTime @default(now())
}

/// Consumo de tokens por turno. Existe por dos motivos: hacer cumplir el tope
/// por usuario del proveedor pago, y poder ver quien gasta cuanto.
model TokenUsage {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// dato historico, no leer: reemplazado por aiModelId (ver AiModel).
  provider         ModelChoice?
  aiModelId        String?
  aiModel          AiModel?     @relation(fields: [aiModelId], references: [id], onDelete: SetNull)
  model            String
  promptTokens     Int          @default(0)
  completionTokens Int          @default(0)
  /// Subconjunto de promptTokens, NO un adicional (ver src/lib/ai/provider.ts).
  cachedInputTokens Int         @default(0)
  /// A que recurso perteneceio el turno. NULL en todo lo historico: nunca se
  /// backfillea, es dato que no existia antes de esta columna.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Congelado al momento de escribir, con los tres precios vigentes ese dia
  /// (ver abajo). NULL cuando a ese motor le faltaba algun precio: nunca se
  /// inventa un costo. Escala 10, no 6: ver la migracion 20260920000000.
  costUsd                  Decimal? @db.Decimal(16, 10)
  priceInputSnapshot       Decimal? @db.Decimal(12, 6)
  priceOutputSnapshot      Decimal? @db.Decimal(12, 6)
  priceCachedInputSnapshot Decimal? @db.Decimal(12, 6)
  createdAt        DateTime     @default(now())

  @@index([userId, provider])
  @@index([createdAt])
  @@index([projectId])
  @@index([userId, createdAt])
}

model Project {
  id            String         @id @default(uuid())
  title         String         @default("Nuevo Recurso")
  description   String?
  slug          String         @unique
  currentHtml   String         @default("<!DOCTYPE html><html><head><meta charset='UTF-8'><script src='https://cdn.tailwindcss.com'></script></head><body class='p-6 text-center text-gray-700 font-sans'><p>Tu recurso aparecerá acá...</p></body></html>")
  screenshotUrl String?
  /// Cuando se saco la portada vigente. Se compara contra `updatedAt` para
  /// saber si quedo vieja (ver design.md §6 de publicacion-likes-y-motores).
  /// NULL = portada sacada antes de que esta columna existiera; se trata
  /// como FRESCA, nunca como vieja.
  screenshotAt  DateTime?
  isInGallery   Boolean        @default(false)
  /// dato historico, no leer: reemplazado por aiModelId (ver AiModel).
  selectedModel ModelChoice    @default(MINIMAX)
  aiModelId     String?
  aiModel       AiModel?       @relation(fields: [aiModelId], references: [id], onDelete: SetNull)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Marca los recursos creados por la cuenta compartida de demo (design.md
  /// #8): habilita el purgado masivo desde /admin/demo sin rozar nada de
  /// docentes reales.
  createdByDemo Boolean        @default(false)
  /// odd/tasks/generacion-simple-y-reanudable.md (T2): opt-in per project for
  /// "3 versions per request", off by default. Only takes effect when
  /// `AppSettings.versionsForAll` is also on — see
  /// `src/lib/ai/versiones.ts`/`capacidades.ts`.
  versionsEnabled Boolean      @default(false)
  threads       ChatThread[]
  assets        ProjectAsset[]
  tokenUsage    TokenUsage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  /// M8 (design.md #7): último admin que actuó sobre este recurso sin ser
  /// su dueño, y cuándo. Un puntero simple, no un historial — se
  /// sobrescribe en cada mutación hecha por un admin en nombre de otro
  /// docente. NULL mientras el dueño es el único que lo tocó.
  lastAdminActorId  String?
  lastAdminActor    User?      @relation("ProjectLastAdminActor", fields: [lastAdminActorId], references: [id], onDelete: SetNull)
  lastAdminActionAt DateTime?
  likes             ProjectLike[]
  /// T4 ("Deshacer cambios de la IA"): instantáneas
  /// para volver atrás, podadas a las 20 más nuevas por stream.ts.
  /// Back-relation de ProjectSnapshot.project.
  snapshots         ProjectSnapshot[]

  @@index([userId])
  @@index([isInGallery, updatedAt])
}

/// Un "me gusta" de un docente sobre un recurso publicado (galeria, M9). No
/// hay contador desnormalizado en `Project` a proposito: la galeria lee 60
/// filas y un contador paralelo se desincroniza (ver design.md §11).
model ProjectLike {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  /// Un like por docente por recurso. Es TODA la regla anti-abuso que hay.
  @@unique([userId, projectId])
  /// El unique arranca con userId, asi que NO sirve para contar por recurso
  /// ni para el join del `orderBy _count`. Este indice es el que sirve eso,
  /// y de paso el borrado en cascada de un recurso.
  @@index([projectId])
}

/// La cuenta de un proveedor de IA (design.md de
/// catalogo-de-proveedores/design.md §1): guarda la clave cifrada UNA sola
/// vez aunque varios `AiModel` la usen, y deja legal la misma cuenta de
/// proveedor dos veces (una clave para la escuela, otra personal).
model AiProvider {
  /// Generado por la app con crypto.randomUUID() ANTES de cifrar la clave: es
  /// el AAD del cifrado (ver src/lib/crypto/secretos.ts). No lleva @default.
  id String @id
  /// Slug estable: "gmi", "deepseek", "openrouter". Es lo que hace legible
  /// "el mismo proveedor dos veces".
  kind String
  /// Lo que distingue dos cuentas del mismo kind en el desplegable del
  /// formulario de motor: "GMI — cuenta de la escuela".
  label String
  baseUrl String
  /// T2 (verificador): "chat" (Chat Completions, todo lo que había antes de
  /// esta columna) o "responses" (OpenAI Responses API — la única que
  /// combina function tools con razonamiento). String, no enum: mismo
  /// criterio que `kind` en esta misma tabla.
  apiFormat String @default("chat")

  /// AES-256-GCM. Formato "v1.<nonce>.<ct>.<tag>" en base64url. Nunca sale del server.
  apiKeyCipher String?
  /// Ultimos 4 caracteres de la clave en claro, para reconocerla en el panel.
  apiKeyHint String?

  /// Apagar la cuenta apaga sus motores sin tocarles su propio `enabled`, así
  /// que volver a prenderla restaura el estado anterior de cada uno.
  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modelos AiModel[]
}

/// El catalogo de motores de IA: reemplaza al enum ModelChoice como fuente de
/// verdad en tiempo de ejecucion. Cada fila es un motor que un admin puede
/// prender, apagar, reordenar o marcar como el que arranca por defecto.
model AiModel {
  id String @id
  /// La cuenta de proveedor dueña de la clave y la URL base (ver AiProvider).
  /// `onDelete: Restrict` porque no hay ruta de borrado de proveedor.
  providerId String
  provider   AiProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  /// El identificador exacto que espera la API del proveedor.
  providerModel String
  /// Lo que ve el docente en el selector.
  displayName String
  /// Una linea para el docente, debajo del selector.
  description String?
  /// Nota interna. El docente nunca la ve.
  adminNote String?

  /// Precio APROXIMADO en USD por millon de tokens. NULL = sin cargar (≠ 0 = gratis).
  priceInputPerMToken Decimal? @db.Decimal(12, 6)
  /// Entrada que el proveedor ya tenia cacheada. Suele costar bastante menos.
  priceCachedInputPerMToken Decimal? @db.Decimal(12, 6)
  priceOutputPerMToken      Decimal? @db.Decimal(12, 6)

  enabled Boolean @default(true)
  /// Aparece en el selector del docente. DeepSeek va en false: es el respaldo.
  selectableByTeacher Boolean @default(true)
  /// Ver el indice unico parcial en la migracion: a lo sumo un true.
  isDefault           Boolean @default(false)
  /// T3 (verificador, odd/tasks/verificador.md): el motor que revisa cada
  /// recurso nuevo/ajuste después de la autoprueba (POST /api/chat/verificar).
  /// Mismo criterio que `isDefault`: índice único parcial en la migración
  /// (a lo sumo un true), y el mismo patrón de "bajar el anterior en la
  /// misma transacción antes de subir éste" en PATCH /api/admin/models/:id.
  /// `false` en TODAS las filas = el verificador está apagado del todo
  /// (`motorVerificador()` en catalogo.ts devuelve `null`).
  isVerifier          Boolean @default(false)
  sortOrder           Int     @default(0)

  /// Techo de tokens de salida, NO una cuota: se cobra lo que el modelo
  /// escribe, no esto. Alto a propósito, porque la IA reescribe el recurso
  /// ENTERO en cada turno y no un diff: la respuesta pesa lo que pesa el
  /// documento, siempre.
  maxOutputTokens Int     @default(131072)
  maxInputChars   Int     @default(400000)
  supportsVision  Boolean @default(false)
  /// Tope por usuario, en tokens. 0 = sin tope.
  userTokenLimit  Int     @default(0)
  /// La ventana sobre la que se mide `userTokenLimit`, en horas. 0 = desde
  /// siempre (el comportamiento viejo: un tope de por vida que no se repone).
  ///
  /// Es una ventana MOVIL, no un ciclo que se reinicia: se suman las últimas N
  /// horas contra `TokenUsage.createdAt`. Así no hace falta ningún trabajo
  /// programado que resetee contadores, no hay estado que se pueda corromper,
  /// y el cupo se va liberando de a poco en vez de volver todo junto a
  /// medianoche.
  userTokenWindowHours Int @default(0)
  /// Cuánto se le deja razonar antes de contestar, para los modelos que lo
  /// soportan: "none" | "low" | "high". NULL = no mandar el parámetro,
  /// que es lo correcto para todo proveedor que no lo conozca (mandarlo a
  /// ciegas es un 400). Ver src/lib/ai/provider.ts.
  reasoningEffort String?
  /// Con qué nombre viaja el razonamiento, porque no hay uno solo:
  ///   "reasoning_effort" → DeepSeek, dialecto OpenAI. Manda el nivel tal cual.
  ///   "thinking"         → MiniMax M3. Manda {type: "enabled"|"disabled"}.
  /// NULL = usar "reasoning_effort". Sólo importa si reasoningEffort no es NULL.
  reasoningParam  String?

  fallbackModelId String?
  fallbackModel   AiModel?  @relation("Respaldo", fields: [fallbackModelId], references: [id], onDelete: SetNull)
  respaldoDe      AiModel[] @relation("Respaldo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects   Project[]
  tokenUsage TokenUsage[]

  @@unique([providerId, providerModel])
  @@index([enabled, sortOrder])
}

model ChatThread {
  id        String        @id @default(uuid())
  title     String        @default("Conversación")
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())

  @@index([projectId])
}

model ChatMessage {
  id          String     @id @default(uuid())
  threadId    String
  thread      ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role        String // "user" | "assistant" | "system"
  content     String
  attachments String? // URLs de archivos o PDFs parseados
  createdAt   DateTime   @default(now())
  /// Quién escribió este turno cuando NO fue la persona dueña del recurso
  /// (M8, design.md #7): un admin actuando en nombre de un docente. NULL en
  /// el caso normal, que es el dueño escribiendo su propio recurso.
  authorUserId String?
  authorUser   User?    @relation("ChatMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  /// T4: cuándo se deshizo este mensaje. `NULL` =
  /// sigue vigente. Deshacer un turno marca A LA VEZ el mensaje "assistant"
  /// que lo cierra y el pedido "user" del docente que lo disparó, así el
  /// modelo deja de ver el turno ENTERO (ver el filtro de historial en
  /// stream.ts) y no sólo la mitad.
  undoneAt     DateTime?
  /// La instantánea de "el HTML de antes de este turno", sólo en mensajes
  /// "assistant" que cambiaron el recurso. Relación 1:1 opcional — la FK
  /// vive del lado de ProjectSnapshot (`chatMessageId` es `@unique` ahí).
  snapshot     ProjectSnapshot?
  /// T9 ("Varias versiones al crear un recurso"):
  /// cuál de `variants` está elegida ahora mismo (1, 2 o 3). Se pone en 1 al
  /// crear el turno (`Project.currentHtml` ya arranca en la versión 1) y
  /// cambia con `POST /api/projects/[id]/variant`. `NULL` en cualquier
  /// mensaje que no sea un turno de versiones.
  chosenVariantIndex Int?
  /// Las hasta 3 versiones que generó ESTE turno en paralelo (T9), cuando
  /// correspondía (`puedePedirVersiones` Y el recurso todavía era el de
  /// arranque). `stream.ts` las borra al empezar cualquier turno POSTERIOR
  /// del mismo proyecto — nunca se acumulan turno a turno. Back-relation de
  /// ResourceVariant.chatMessage.
  variants     ResourceVariant[]
  /// T16 (round 4, odd/tasks/arnes-robustez.md): el checklist de
  /// comportamientos armado ANTES de generar un recurso NUEVO
  /// (`src/lib/ai/checklist.ts`, JSON de `ItemChecklist[]`, mismo criterio
  /// que `attachments`). `NULL` en cualquier mensaje que no sea el cierre de
  /// un turno de creación con checklist (un ajuste, un turno viejo de antes
  /// de T16, o uno en el que el paso falló/dio muy pocos ítems). El
  /// checklist VIGENTE de un proyecto es el de este campo en el mensaje
  /// "assistant" con `checklist != null` y `undoneAt == null` más reciente
  /// (`checklistActual`, `src/lib/ai/checklist-db.ts`) — deshacer ese turno
  /// lo descarta solo, sin lógica aparte.
  checklist    String?

  @@index([threadId, createdAt])
}

/// Una de las hasta 3 versiones que generó un "turno de versiones" (T9,
/// "Varias versiones al crear un recurso" (T9):
/// cuelga del ÚNICO mensaje "assistant" que cierra ese turno (las tres
/// comparten el mismo mensaje — el turno persiste un solo texto fijo, no
/// uno por versión). Tabla aparte y NO una columna grande en ChatMessage a
/// propósito: `stream.ts` arma el contexto del modelo leyendo ChatMessage en
/// cada turno, y esas consultas de historial tienen que seguir livianas —
/// no pueden arrastrar hasta 3 documentos HTML completos que además nunca
/// vuelven como contexto (sólo se ofrecen al docente, para elegir).
model ResourceVariant {
  id            String      @id @default(uuid())
  chatMessageId String
  chatMessage   ChatMessage @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  /// 1, 2 o 3 — el orden en que se ofrecen los chips ("Versión 1 · 2 · 3"),
  /// no el orden de llegada (la 1 siempre es la que se transmitió en vivo;
  /// la 2 y la 3 pueden terminar en cualquier orden entre sí).
  index         Int
  html          String
  createdAt     DateTime    @default(now())

  @@unique([chatMessageId, index])
}

/// Instantánea del HTML de un recurso justo ANTES de un turno de la IA que lo
/// cambió (T4, "Deshacer cambios de la IA, para
/// todos, con varios niveles"). Cuelga del mensaje "assistant" que cierra ese
/// turno (`chatMessageId`, único: a lo sumo una instantánea por turno), así
/// "deshacer ESTE turno" es simplemente "restaurar `html` y borrar esta
/// fila". `stream.ts` la crea cuando el turno cambia el recurso y poda las
/// más viejas, dejando a lo sumo 20 por proyecto: deshacer alcanza varios
/// niveles hacia atrás, pero no infinitos.
model ProjectSnapshot {
  id            String      @id @default(uuid())
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chatMessageId String      @unique
  chatMessage   ChatMessage @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  /// El HTML tal cual estaba INMEDIATAMENTE ANTES de este turno (no el que
  /// dejó el turno: ese es `Project.currentHtml`, o la instantánea del turno
  /// que sigue).
  html          String
  createdAt     DateTime    @default(now())

  @@index([projectId, createdAt])
}

model CustomRule {
  id        String   @id @default(uuid())
  title     String
  content   String
  isGlobal  Boolean  @default(false) // Solo admins crean reglas globales base
  isActive  Boolean  @default(true)
  userId    String? // Null si es global
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, isActive])
  @@index([isGlobal, isActive])
}

model ProjectAsset {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filename  String
  url       String
  fileType  String // "image" | "pdf"
  // Texto extraido de los PDFs para inyectarlo como contexto de la IA (SPEC 4.2).
  extractedText String?
  createdAt DateTime @default(now())

  @@index([projectId])
}
