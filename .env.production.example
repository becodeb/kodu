# ─────────────────────────────────────────────────────────────
# KoduEdu — variables de PRODUCCIÓN
# Copiar a `.env.production` (no se versiona) y completar.
# Lo consumen los tres servicios de docker-compose.prod.yml.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production

# Base de datos ────────────────────────────────────────────────
# Las tres primeras las lee la imagen de Postgres al inicializar el volumen.
POSTGRES_USER=kodu
POSTGRES_PASSWORD=cambiame-por-una-clave-fuerte
POSTGRES_DB=koduedu
# El host es `db`: el nombre del servicio dentro de la red kodu_internal.
DATABASE_URL=postgresql://kodu:cambiame-por-una-clave-fuerte@db:5432/koduedu?schema=public

# Sesiones ─────────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
SESSION_TTL_HOURS=168

# Acceso institucional ─────────────────────────────────────────
ALLOWED_EMAIL_DOMAINS=rededucativa.edu.ar
ADMIN_EMAILS=admin@rededucativa.edu.ar


# ─────────────────────────────────────────────────────────────
# Motores de IA. Los dos hablan el dialecto OpenAI.
# OJO: las BASE_URL van SIN /v1 (el codigo concatena /v1/chat/completions).
# ─────────────────────────────────────────────────────────────
# Alpha: gratuito, multimodal, sin cupo. Es el default.
AI_ALPHA_API_KEY=
AI_ALPHA_BASE_URL=https://openrouter.ai/api
AI_ALPHA_MODEL=stealth/ox-alpha
AI_ALPHA_MAX_TOKENS=65536
AI_ALPHA_USER_TOKEN_LIMIT=0

# DeepSeek: se paga por token, por eso lleva tope por docente (0 = sin tope).
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_DEEPSEEK_MODEL=deepseek-v4-flash
AI_DEEPSEEK_MAX_TOKENS=8192
AI_DEEPSEEK_USER_TOKEN_LIMIT=300000

# Si Alpha recibe las imagenes adjuntas.
AI_VISION=true

# App ──────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://app.rededucativa.edu.ar
UPLOADS_DIR=/app/uploads
MAX_UPLOAD_MB=10
