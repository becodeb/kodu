# ─────────────────────────────────────────────────────────────
# KoduEdu — variables de PRODUCCIÓN
# Copiar a `.env.production` (no se versiona) y completar.
# Lo consumen los tres servicios de docker-compose.prod.yml.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production

# Base de datos ────────────────────────────────────────────────
# Las tres primeras las lee la imagen de Postgres al inicializar el volumen.
POSTGRES_USER=kodu
POSTGRES_PASSWORD=cambiame-por-una-clave-fuerte
POSTGRES_DB=koduedu
# El host es `db`: el nombre del servicio dentro de la red kodu_internal.
DATABASE_URL=postgresql://kodu:cambiame-por-una-clave-fuerte@db:5432/koduedu?schema=public

# Sesiones ─────────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
SESSION_TTL_HOURS=168

# Acceso institucional ─────────────────────────────────────────
ALLOWED_EMAIL_DOMAINS=rededucativa.edu.ar
ADMIN_EMAILS=admin@rededucativa.edu.ar

# Motor de IA (Etapa 2) ────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

# Tope de tokens de la respuesta. Alto a proposito: la IA devuelve el documento
# HTML completo en cada edicion, y con el default de la API (4.096) el codigo
# vuelve cortado a la mitad y el turno termina sin texto ni recurso.
AI_MAX_TOKENS=16384

# "true" solo si el modelo configurado acepta imagenes (formato OpenAI image_url).
# Con un modelo de solo texto, ponerlo en true hace que la API devuelva 400.
AI_VISION=false

# App ──────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://app.rededucativa.edu.ar
UPLOADS_DIR=/app/uploads
MAX_UPLOAD_MB=10
